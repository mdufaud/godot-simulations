// One point sample of the source at the sample's reverse-drifted position, as
// the authors' accumulation pass shades it (AccumulateOffset.hlsl): each
// sample is jittered over its pixel (R2 sequence), and the progressive average
// in mixwell_accumulate is the pixel filter. A footprint filter here would
// blur the creases a second time.
void main() {
	uint index = gl_GlobalInvocationID.x;
	ivec2 work_size = work_dims();
	uint count = uint(work_size.x * work_size.y);
	if (index >= count) {
		return;
	}
	ivec2 pixel = work_pixel(index);
	vec2 coordinate = load_coordinate(pixel);
	vec3 result = pigment(coordinate, params.dims.w);
	vec3 source = pigment(display_coordinate(pixel), params.dims.w);
	imageStore(sample_image, pixel, vec4(result, 1.0));
	imageStore(source_image, pixel, vec4(source, 1.0));
	imageStore(diagnostic_image, pixel, vec4(0.0));
}
