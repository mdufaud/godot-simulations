// Line-family operations, each a closed-form reverse-drift function of the
// sample point (mixwell_common.comp): LINE (0), the Nonpareil comb LINE_COMB
// (1), GEL_GIT (4) and TRI_WAVE (5). Push constant per operation:
//   line.xy origin, line.zw direction; segment.x phase (tines and waves shift
//   across by it), segment.y epsilon, segment.zw LINE extent or TRI_WAVE
//   (wavelength, amplitude); operation.y comb gap (pitch), operation.z TRI_WAVE
//   broken flag, operation.w comb noise.
vec2 pattern_drift(int operation_type, vec2 local, float epsilon, vec2 direction) {
	if (operation_type == 1) {
		return rd_nonpareil(local, epsilon, direction, params.operation.y, params.operation.w,
				params.field.z);
	}
	if (operation_type == 4) {
		return rd_gel_git(local, epsilon, direction, params.operation.y);
	}
	return rd_tri_wave_comb(local, epsilon, direction, params.segment.z, params.segment.w,
			params.operation.z > 0.5, params.operation.y, params.field.z, params.field.y);
}


void main() {
	uint index = gl_GlobalInvocationID.x;
	ivec2 work_size = work_dims();
	uint count = uint(work_size.x * work_size.y);
	if (index >= count) {
		return;
	}
	ivec2 pixel = work_pixel(index);
	vec2 coordinate = load_coordinate(pixel);
	vec2 direction = params.line.zw;
	float direction_length = length(direction);
	if (direction_length <= 1.0e-30) {
		imageStore(coords_dst, pixel, vec4(coordinate, 0.0, 0.0));
		imageStore(displacement_dst, pixel, imageLoad(displacement_src, source_pixel(pixel)));
		return;
	}
	direction /= direction_length;
	vec2 perpendicular = vec2(-direction.y, direction.x);
	float epsilon = params.segment.y > 1.0e-30 ? params.segment.y : params.field.x;
	int operation_type = int(round(params.operation.x));
	vec2 origin = params.line.xy + perpendicular * params.segment.x;
	vec2 local = coordinate - origin;
	vec2 drift;
	if (operation_type == 1 || operation_type == 4 || operation_type == 5) {
		drift = pattern_drift(operation_type, local, epsilon, direction);
		if (slip_enabled()) {
			// Images of the pattern (H f(M p)): a comb's across the walls its
			// tines run along, a wave's across every wall and corner.
			for (int index = 0; index < 8; index++) {
				ivec2 image = operation_type == 5 ? SLIP_IMAGES[index]
						: (index < 2 ? parallel_wall_image(direction, 2 * index - 1) : ivec2(0));
				if (image != ivec2(0)) {
					drift += reflection_matrix(image) * pattern_drift(operation_type,
							mirror_point(coordinate, image) - origin, epsilon, direction);
				}
			}
		}
		if (operation_type == 1) {
			drift += drift_compensation(direction, epsilon);
		}
	} else {
		float extent_weight = line_extent_weight(coordinate, origin, direction, epsilon,
				params.field.z, params.segment.zw);
		drift = (slip_enabled() ? slip_line_velocity(coordinate, origin, direction, epsilon)
				: line_velocity(coordinate, origin, direction, epsilon)) * extent_weight;
	}
	vec2 mapped = periodic_wrap(coordinate + drift);
	vec2 source_coordinate = display_coordinate(pixel);
	vec2 displacement = periodic_optimized()
			? mapped - source_coordinate
			: imageLoad(displacement_src, source_pixel(pixel)).xy + drift;
	imageStore(coords_dst, pixel, vec4(mapped, 0.0, 0.0));
	imageStore(displacement_dst, pixel, vec4(periodic_wrap(displacement), 0.0, 0.0));
}
