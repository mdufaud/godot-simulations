// AVBD warm start: share of the multipliers and penalties kept between substeps.
const float MULTIPLIER_RETAINED = 0.98;
const float PENALTY_RETAINED = 0.99;

void main() {
	uint i = gl_GlobalInvocationID.x;
	if (i >= uint(params.grid.z)) {
		return;
	}
	if (params.misc.w == 1) {
		tension.data[i] *= vec4(vec2(MULTIPLIER_RETAINED), vec2(PENALTY_RETAINED));
	}
	vec4 pw = positions.data[i];
	int w = params.misc.x;
	ivec2 texel = ivec2(int(i) % w, int(i) / w);
	if (predicted.data[i].w > 0.5) {
		imageStore(position_tex, texel, vec4(pw.xyz, 1.0));
		return;
	}
	vec3 p = collide(deltas.data[i].xyz);
	predicted.data[i] = vec4(p, 0.0);
	velocities.data[i] = vec4((p - pw.xyz) * params.sim.y, 0.0);
	positions.data[i] = vec4(p, 0.0);
	imageStore(position_tex, texel, vec4(p, 0.0));
}
