// SPARSE ONLY. Solves the tile-level system fire_press_restrict assembled.
//
// One unknown per resident tile is at most NSLOTS = 2048 equations, which is
// small enough that the whole solve is one workgroup with the unknowns in shared
// memory: no global ping-pong, no dispatch per iteration, and the relaxation
// runs at LDS latency. Dispatched (1, 1, 1) — the only stage of the solver that
// is not one workgroup per tile.
//
// Red-black again, on the parity of the virtual tile so that a tile's six
// neighbours are all of the other colour, and over-relaxed: at a diameter of
// several tens of tiles the coarse grid is where an unaccelerated smoother would
// stall in turn, and it is also where over-relaxation is cheapest.
//
// The stencil is the aggregated one derived in fire_press_restrict:
//   faces * P_C - sum(P_nb) = rhs_C,  faces = 6, or 5 on the domain floor where
// the wall is Neumann. Neighbours that are outside the domain, not resident, or
// not themselves coarse unknowns are Dirichlet P = 0: they still count in the
// diagonal, they just contribute no term.

const uint COARSE_ITERS = 64u;
const ivec3 COARSE_DIR[6] = ivec3[6](ivec3(-1, 0, 0), ivec3(1, 0, 0),
	ivec3(0, -1, 0), ivec3(0, 1, 0), ivec3(0, 0, -1), ivec3(0, 0, 1));

shared float coarse_p[COARSE_SLOTS];

void main() {
	uint threads = gl_WorkGroupSize.x * gl_WorkGroupSize.y * gl_WorkGroupSize.z;
	uint tid = gl_LocalInvocationIndex;
	uint count = min(tile_counts[C_ACTIVE_WORD], COARSE_SLOTS);

	// Resolve the coarse adjacency once. It cannot be done in the restrict pass:
	// a tile's neighbour is found through the indirection volume as an atlas slot,
	// and the slot -> unknown map is only complete once every restrict workgroup
	// has run.
	for (uint a = tid; a < count; a += threads) {
		ivec3 vt = tile_of_index(active_list[a]);
		for (int f = 0; f < 6; ++f) {
			ivec3 nvt = vt + COARSE_DIR[f];
			uint nb = COARSE_NONE;
			if (all(greaterThanEqual(nvt, ivec3(0))) && all(lessThan(nvt, VTILES))) {
				uint slot = imageLoad(tile_indir, nvt).r;
				if (slot < TILE_SLOT_MAX) {
					uint na = coarse_idx[COARSE_SLOT_BASE + slot];
					if (na < count && coarse_idx[na] == COARSE_INTERIOR) {
						nb = na;
					}
				}
			}
			coarse_idx[COARSE_NB_BASE + a * 6u + uint(f)] = nb;
		}
		coarse_p[a] = 0.0;
	}
	groupMemoryBarrier();
	barrier();

	float omega = params.event2.w;
	for (uint it = 0u; it < COARSE_ITERS; ++it) {
		for (uint colour = 0u; colour < 2u; ++colour) {
			for (uint a = tid; a < count; a += threads) {
				if (coarse_idx[a] != COARSE_INTERIOR) {
					continue;
				}
				ivec3 vt = tile_of_index(active_list[a]);
				if (uint((vt.x + vt.y + vt.z) & 1) != colour) {
					continue;
				}
				float sum = 0.0;
				for (uint f = 0u; f < 6u; ++f) {
					uint nb = coarse_idx[COARSE_NB_BASE + a * 6u + f];
					if (nb != COARSE_NONE) {
						sum += coarse_p[nb];
					}
				}
				float faces = (vt.y == 0) ? 5.0 : 6.0;
				coarse_p[a] += omega * ((sum + coarse_val[a]) / faces - coarse_p[a]);
			}
			barrier();
		}
	}

	for (uint a = tid; a < count; a += threads) {
		coarse_val[COARSE_P_BASE + a] = coarse_p[a];
	}
}
