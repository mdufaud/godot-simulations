void main() {
	uint i = gl_GlobalInvocationID.x;
	if (i >= num_cells() || cell_types.data[i] != CELL_FLUID) { return; }
	ivec3 c = cell_coord(i);
	if (((c.x + c.y + c.z) & 1) != params.misc.w) { return; }
	ivec3 dims = params.grid_dims.xyz;
	float sum = 0.0;
	float degree = 0.0;
	for (int axis = 0; axis < 3; axis++) {
		for (int side = -1; side <= 1; side += 2) {
			ivec3 n = c;
			n[axis] += side;
			if (any(lessThan(n, ivec3(0))) || any(greaterThanEqual(n, dims))) { continue; }
			ivec3 face = side > 0 ? n : c;
			if (face_pressure_blocked(face, axis)) { continue; }
			uint ni = cell_index(n);
			if (cell_types.data[ni] == CELL_SOLID) { continue; }
			float aperture = face_open_fraction(face, axis);
			degree += aperture * free_surface_inverse_fraction(i, ni);
			if (cell_types.data[ni] == CELL_FLUID) { sum += aperture * pressure.data[ni]; }
		}
	}
	if (degree <= 0.0) { pressure.data[i] = 0.0; return; }
	float rhs = params.sim.z * divergence.data[i] * cell_open_fraction(i) / max(params.sim.x, 1.0e-8);
	float next_pressure = (sum - rhs * params.grid_origin_dx.w * params.grid_origin_dx.w) / degree;
	pressure.data[i] += params.solve.w * (next_pressure - pressure.data[i]);
}
