layout(std430, set = 0, binding = 30) restrict buffer CellGeometry { vec4 data[]; } cell_geometry;
layout(std430, set = 0, binding = 31) restrict buffer CellVertexRanges { uvec4 data[]; } cell_vertex_ranges;
