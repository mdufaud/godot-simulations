vec2 read_extension(uint i) {
	return params.misc.w == 0 ? face_extension_a.data[i] : face_extension_b.data[i];
}

void main() {
	uint i = gl_GlobalInvocationID.x;
	uint count = num_faces();
	if (i >= count * 3u) { return; }
	uint component = i / count;
	ivec3 face = face_coord(i % count);
	vec2 value = read_extension(i);
	if (value.y == 0.0) {
		float sum = 0.0;
		float weight = 0.0;
		for (int axis = 0; axis < 3; axis++) {
			for (int side = -1; side <= 1; side += 2) {
				ivec3 neighbor = face;
				neighbor[axis] += side;
				if (any(lessThan(neighbor, ivec3(0))) || any(greaterThanEqual(neighbor, params.face_dims.xyz))) { continue; }
				vec2 source = read_extension(component * count + face_index(neighbor));
				if (source.y > 0.0) { sum += source.x; weight += 1.0; }
			}
		}
		if (weight > 0.0) { value = vec2(sum / weight, 1.0); }
	}
	if (params.misc.w == 0) { face_extension_b.data[i] = value; }
	else { face_extension_a.data[i] = value; }
	if (int(params.solve.z) == 5) {
		if (i == 0u) {
			extension_control.stats.z = params.misc.w == 0 ? 1u : 0u;
			extension_control.next_dispatch.w++;
		}
		if (value.y == 0.0 && fluid_face(face, int(component))) {
			atomicExchange(extension_control.next_dispatch.x,
				(count * 3u + uint(APIC_WORKGROUP_SIZE) - 1u) / uint(APIC_WORKGROUP_SIZE));
		}
	}
}
