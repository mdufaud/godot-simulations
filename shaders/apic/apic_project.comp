void main() {
	uint invocation = gl_GlobalInvocationID.x;
	uint faces = num_faces();
	if (invocation >= faces * 3u) { return; }
	int component = int(invocation / faces);
	uint index = invocation % faces;
	ivec3 f = face_coord(index);
	float value = projected_face_velocity(f, component);
	if (component == 0) { face_u.data[index] = value; }
	else if (component == 1) { face_v.data[index] = value; }
	else { face_w.data[index] = value; }
}
