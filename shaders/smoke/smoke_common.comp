layout(local_size_x = WG_X, local_size_y = WG_Y, local_size_z = WG_Z) in;

layout(push_constant, std430) uniform Params {
	ivec4 dims;     // cells xyz, w light downsample
	vec4 domain;    // origin m xyz, w cell size m
	vec4 sim;       // dt s, buoyancy m/s2/K, smoke weight m/s2, vorticity confinement
	vec4 decay;     // density, temperature, velocity, wind relax (Hz)
	vec4 wind;      // wind x, wind z (m/s), extinction 1/m, unused
	vec4 light;     // xyz direction to the sun, w light march step (cells)
	ivec4 counts;   // sources, obstacles, red-black parity or STAGE_* flags, multigrid level
} pc;

// Pressure neighbour code: bits 0-5 fluid neighbours (+x -x +y -y +z -z), bits
// 6-8 count of open (p = 0) neighbours, CODE_SOLID for a solid cell.
const int CODE_OPEN = 64;
const int CODE_SOLID = 512;
// Multigrid coarse cell past an open side, held at p = 0.
const int CODE_FIXED = 1024;

// Stage flags in counts.z (flow maps, STAGE_* defines): advect and forces skip
// velocity or scalars, a flow-map march starts at identity, forces write the force
// (m/s2) instead of the forced velocity, the reinit projection holds the open
// sides' face velocity (p Neumann).

bool in_grid(ivec3 c) {
	return all(greaterThanEqual(c, ivec3(0))) && all(lessThan(c, pc.dims.xyz));
}

vec3 cell_center_m(ivec3 c) {
	return pc.domain.xyz + (vec3(c) + 0.5) * pc.domain.w;
}

ivec3 unit(int a) {
	return ivec3(equal(ivec3(a), ivec3(0, 1, 2)));
}

// v[a] without dynamic vector indexing, which a Godot SPIR-V pass logs as unsupported.
float axis(vec3 v, int a) {
	return dot(v, vec3(unit(a)));
}

// Velocity is staggered (MAC), one R32F field per axis: texel t of the axis-a
// field is the low-a face of cell t. Face fields (velocity, walls) are one texel
// larger than the grid on every axis so the high boundary faces exist; texels
// that are no face of their axis stay 0. Walls holds, per texel, the bit mask of
// its faces that carry a solid's velocity (written by the forces pass).
bool face_valid(ivec3 t, int a) {
	return all(greaterThanEqual(t, ivec3(0))) && all(lessThanEqual(t, pc.dims.xyz - 1 + unit(a)));
}

// Face centre in cell units.
vec3 face_pos(ivec3 t, int a) {
	return vec3(t) + 0.5 - 0.5 * vec3(unit(a));
}

// Axis-a face field at p (cell units), clamped to that axis's faces.
float sample_face(sampler3D field, vec3 p, int a) {
	vec3 e = vec3(unit(a));
	vec3 texel = clamp(p, 0.5 - 0.5 * e, vec3(pc.dims.xyz) - 0.5 + 0.5 * e) + 0.5 * e;
	return texture(field, texel / vec3(pc.dims.xyz + 1)).r;
}

vec3 sample_velocity(sampler3D u, sampler3D v, sampler3D w, vec3 p) {
	return vec3(sample_face(u, p, 0), sample_face(v, p, 1), sample_face(w, p, 2));
}
