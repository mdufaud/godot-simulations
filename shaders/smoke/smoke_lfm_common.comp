// Leapfrog flow maps (Sun et al. 2025): a map position p and one Jacobian column
// marched along a velocity held over the step, RK4. h is in cells per (m/s):
// positive for the forward map (dp = u, dcol = grad u col), negative backward.
// Velocities are read with the reference code's quadratic B-spline, whose exact
// gradient keeps the Jacobian consistent with the map.

void n2_axis(float x, out float w[3], out float dw[3]) {
	w[0] = 0.5 * (1.5 - x) * (1.5 - x);
	w[1] = 0.75 - (x - 1.0) * (x - 1.0);
	w[2] = 0.5 * (x - 0.5) * (x - 0.5);
	dw[0] = x - 1.5;
	dw[1] = 2.0 - 2.0 * x;
	dw[2] = x - 0.5;
}

// Axis-a face field at p (cell units): value, then its gradient per cell.
vec4 n2_face(sampler3D field, vec3 p, int a) {
	vec3 e = vec3(unit(a));
	vec3 q = clamp(p - 0.5 + 0.5 * e, vec3(0.5001), vec3(pc.dims.xyz) + e - 1.5001);
	ivec3 base = ivec3(floor(q - 0.5));
	vec3 x = q - vec3(base);
	float wx[3], wy[3], wz[3], dx[3], dy[3], dz[3];
	n2_axis(x.x, wx, dx);
	n2_axis(x.y, wy, dy);
	n2_axis(x.z, wz, dz);
	vec4 r = vec4(0.0);
	for (int k = 0; k < 3; k++) {
		for (int j = 0; j < 3; j++) {
			for (int i = 0; i < 3; i++) {
				float f = texelFetch(field, base + ivec3(i, j, k), 0).r;
				r += f * vec4(wx[i] * wy[j] * wz[k], dx[i] * wy[j] * wz[k], wx[i] * dy[j] * wz[k],
					wx[i] * wy[j] * dz[k]);
			}
		}
	}
	return r;
}

vec3 field_at(sampler3D u, sampler3D v, sampler3D w, vec3 p) {
	return vec3(n2_face(u, p, 0).x, n2_face(v, p, 1).x, n2_face(w, p, 2).x);
}

// g[l] is the field's derivative along axis l, in (m/s) per cell.
vec3 field_and_gradient(sampler3D u, sampler3D v, sampler3D w, vec3 p, out mat3 g) {
	vec4 fu = n2_face(u, p, 0);
	vec4 fv = n2_face(v, p, 1);
	vec4 fw = n2_face(w, p, 2);
	g = mat3(vec3(fu.y, fv.y, fw.y), vec3(fu.z, fv.z, fw.z), vec3(fu.w, fv.w, fw.w));
	return vec3(fu.x, fv.x, fw.x);
}

void march_map(sampler3D u, sampler3D v, sampler3D w, inout vec3 p, inout vec3 col, float h) {
	mat3 g;
	vec3 k1p = field_and_gradient(u, v, w, p, g);
	vec3 k1c = g * col;
	vec3 p2 = p + 0.5 * h * k1p;
	vec3 c2 = col + 0.5 * h * k1c;
	vec3 k2p = field_and_gradient(u, v, w, p2, g);
	vec3 k2c = g * c2;
	vec3 p3 = p + 0.5 * h * k2p;
	vec3 c3 = col + 0.5 * h * k2c;
	vec3 k3p = field_and_gradient(u, v, w, p3, g);
	vec3 k3c = g * c3;
	vec3 p4 = p + h * k3p;
	vec3 c4 = col + h * k3c;
	vec3 k4p = field_and_gradient(u, v, w, p4, g);
	vec3 k4c = g * c4;
	p += h / 6.0 * (k1p + 2.0 * k2p + 2.0 * k3p + k4p);
	col += h / 6.0 * (k1c + 2.0 * k2c + 2.0 * k3c + k4c);
}
