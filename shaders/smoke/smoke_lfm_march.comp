// Backward map psi and its Jacobian column T = dpsi/dx_a, one step back along a
// mid-step velocity, newest first.
layout(set = 0, binding = 0) uniform sampler3D velocity_field[3];
layout(set = 0, binding = 1, rgba32f) uniform restrict image3D psi[3];
layout(set = 0, binding = 2, rgba32f) uniform restrict image3D jacobian[3];

void main() {
	ivec3 t = ivec3(gl_GlobalInvocationID);
	if (any(greaterThan(t, pc.dims.xyz))) {
		return;
	}
	float h = -pc.sim.x / pc.domain.w;
	bool first = (pc.counts.z & STAGE_MAP_START) != 0;
	for (int a = 0; a < 3; a++) {
		if (!face_valid(t, a)) {
			continue;
		}
		vec3 p = face_pos(t, a);
		vec3 col = vec3(unit(a));
		if (!first) {
			p = (a == 0 ? imageLoad(psi[0], t) : a == 1 ? imageLoad(psi[1], t) : imageLoad(psi[2], t)).xyz;
			col = (a == 0 ? imageLoad(jacobian[0], t) : a == 1 ? imageLoad(jacobian[1], t)
				: imageLoad(jacobian[2], t)).xyz;
		}
		march_map(velocity_field[0], velocity_field[1], velocity_field[2], p, col, h);
		if (a == 0) {
			imageStore(psi[0], t, vec4(p, 0.0));
			imageStore(jacobian[0], t, vec4(col, 0.0));
		} else if (a == 1) {
			imageStore(psi[1], t, vec4(p, 0.0));
			imageStore(jacobian[1], t, vec4(col, 0.0));
		} else {
			imageStore(psi[2], t, vec4(p, 0.0));
			imageStore(jacobian[2], t, vec4(col, 0.0));
		}
	}
}
