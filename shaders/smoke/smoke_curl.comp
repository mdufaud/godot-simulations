layout(set = 0, binding = 0, r32f) uniform restrict readonly image3D velocity[3];
layout(set = 0, binding = 1, rgba32f) uniform restrict writeonly image3D curl_out;

// Face velocities averaged to the centre of a cell clamped into the grid.
vec3 velocity_at(ivec3 c) {
	c = clamp(c, ivec3(0), pc.dims.xyz - 1);
	return 0.5 * vec3(
		imageLoad(velocity[0], c).r + imageLoad(velocity[0], c + ivec3(1, 0, 0)).r,
		imageLoad(velocity[1], c).r + imageLoad(velocity[1], c + ivec3(0, 1, 0)).r,
		imageLoad(velocity[2], c).r + imageLoad(velocity[2], c + ivec3(0, 0, 1)).r);
}

void main() {
	ivec3 c = ivec3(gl_GlobalInvocationID);
	if (!in_grid(c)) {
		return;
	}
	vec3 dx = velocity_at(c + ivec3(1, 0, 0)) - velocity_at(c - ivec3(1, 0, 0));
	vec3 dy = velocity_at(c + ivec3(0, 1, 0)) - velocity_at(c - ivec3(0, 1, 0));
	vec3 dz = velocity_at(c + ivec3(0, 0, 1)) - velocity_at(c - ivec3(0, 0, 1));
	vec3 w = vec3(dy.z - dz.y, dz.x - dx.z, dx.y - dy.x) * (0.5 / pc.domain.w);
	imageStore(curl_out, c, vec4(w, length(w)));
}
