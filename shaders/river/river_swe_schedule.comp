#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) buffer Control { uint words[]; } control;
layout(push_constant, std430) uniform Params {
    vec4 step;
    uvec4 groups;
    vec4 waterfall;
} params;

void main() {
    if (params.waterfall.w < 0.0) {
        control.words[0] = 0u;
        control.words[1] = floatBitsToUint(0.0);
        control.words[2] = floatBitsToUint(0.0);
        control.words[3] = floatBitsToUint(0.0);
        control.words[4] = 0u;
        control.words[5] = floatBitsToUint(0.0);
        control.words[6] = floatBitsToUint(0.0);
        control.words[7] = floatBitsToUint(0.0);
        control.words[8] = 0u;
        control.words[9] = 0u;
        control.words[10] = control.words[11] = control.words[12] = 0u;
        control.words[13] = control.words[14] = control.words[15] = 0u;
        control.words[16] = floatBitsToUint(0.0);
        control.words[18] = floatBitsToUint(1.0);
        control.words[17] = 0u;
        control.words[19] = 0u;
        control.words[20] = 0u;
        control.words[22] = 0u;
        control.words[23] = control.words[24] = 1u;
        control.words[25] = 0u;
        control.words[26] = control.words[27] = 1u;
        return;
    }
    if (params.waterfall.w == 0.0) {
        control.words[0] = 0u;
        float backlog = min(uintBitsToFloat(control.words[1]) + max(params.step.x, 0.0), 0.5);
        control.words[1] = floatBitsToUint(backlog);
        control.words[8] = 0u;
        control.words[9] = 0u;
        control.words[16] = floatBitsToUint(0.0);
        control.words[18] = floatBitsToUint(1.0);
        control.words[10] = backlog > 1.0e-7 ? params.groups.x : 0u;
        control.words[11] = params.groups.y;
        control.words[12] = 1u;
        control.words[22] = backlog > 1.0e-7 ? 1u : 0u;
        control.words[25] = backlog > 1.0e-7 ? params.groups.z : 0u;
        control.words[13] = control.words[14] = control.words[15] = 0u;
        return;
    }
    if (params.waterfall.w > 1.5) {
        if (uintBitsToFloat(control.words[3]) > 0.0) control.words[19] = 1u - control.words[19];
        control.words[10] = uintBitsToFloat(control.words[1]) > 1.0e-7 ? params.groups.x : 0u;
        control.words[11] = params.groups.y;
        control.words[12] = 1u;
        bool has_work = uintBitsToFloat(control.words[1]) > 1.0e-7;
        control.words[22] = has_work ? 1u : 0u;
        control.words[25] = has_work ? params.groups.z : 0u;
        if (!has_work) {
            control.words[13] = control.words[14] = control.words[15] = 0u;
            control.words[3] = 0u;
            control.words[8] = 0u;
        }
        return;
    }
    float backlog = uintBitsToFloat(control.words[1]);
    float signal = uintBitsToFloat(control.words[0]);
    control.words[18] = floatBitsToUint(max(uintBitsToFloat(control.words[18]), signal));
    float cfl_step = params.step.z * params.step.w / max(signal, 1.0e-6);
    float dt = min(backlog, min(params.step.y, cfl_step));
    control.words[3] = floatBitsToUint(dt);
    control.words[16] = floatBitsToUint(max(uintBitsToFloat(control.words[16]),
        dt * signal / params.step.z));
    control.words[1] = floatBitsToUint(max(backlog - dt, 0.0));
    control.words[2] = floatBitsToUint(uintBitsToFloat(control.words[2]) + dt);
    control.words[0] = 0u;
    control.words[9] = dt > 0.0 ? control.words[9] + 1u : control.words[9];
    if (dt <= 0.0) {
        control.words[10] = control.words[11] = control.words[12] = 0u;
        control.words[13] = control.words[14] = control.words[15] = 0u;
        return;
    }
    control.words[10] = params.groups.x;
    control.words[11] = params.groups.y;
    control.words[12] = 1u;
    control.words[13] = params.groups.z;
    control.words[14] = params.groups.w;
    control.words[15] = 1u;
    float phase = uintBitsToFloat(control.words[5]) + dt;
    float period = params.waterfall.z > 0.5 ? 1.0 / params.waterfall.z : 1.0e20;
    if (phase >= period) {
        phase -= period;
        control.words[4] = (control.words[4] + 1u) % uint(max(params.waterfall.y, 1.0));
        control.words[8] = 1u;
    } else {
        control.words[8] = 0u;
    }
    control.words[5] = floatBitsToUint(phase);
}
