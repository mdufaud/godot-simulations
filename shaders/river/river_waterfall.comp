#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba32f, set = 0, binding = 0) uniform image2D film_a;
layout(rgba32f, set = 0, binding = 1) uniform image2D film_b;
layout(rgba32f, set = 0, binding = 2) uniform writeonly image2D surface_out;
layout(rgba32f, set = 0, binding = 3) uniform writeonly image2D velocity_out;
layout(std430, set = 0, binding = 4) buffer Cascade {
    vec4 lane_input[48];
    vec4 packets[24576];
    vec4 arrivals[96];
    vec4 totals[48];
} cascade;
layout(std430, set = 0, binding = 5) buffer Control { uint words[]; } control;
layout(rgba32f, set = 0, binding = 6) uniform readonly image2D pool_a;
layout(rgba32f, set = 0, binding = 7) uniform readonly image2D terrain;
layout(set = 0, binding = 8) uniform sampler2D source_terrain;
layout(rgba32f, set = 0, binding = 9) uniform readonly image2D pool_b;
layout(set = 0, binding = 10) uniform sampler2D ground_height;
layout(rgba32f, set = 0, binding = 11) uniform writeonly image2D boundary_out;
layout(set = 0, binding = 12) uniform sampler2D obstacle_map;
layout(push_constant, std430) uniform Params {
    vec4 domain;
    vec4 grid;
    vec4 water;
    vec4 source_domain;
    vec4 control_params;
    vec4 waterfall;
    vec4 cascade_params;
    vec4 relaxation;
} params;
layout(set = 0, binding = 13, std140) uniform Rocks {
    vec4 contact;
    vec4 film;
} rocks;
const float FILM_WET_M = 0.0001;
const float FILM_MAX_SPEED_M_S = 30.0;
const float FILM_SEEPAGE_M_S = 0.1;
const float ROCK_FRICTION_HZ = 4.0;
const float PACKET_MAX_AGE_S = 1.8;
float bed_depth_m() { return params.relaxation.z; }
float rock_restitution() { return rocks.contact.x; }
float rock_spread() { return rocks.contact.y; }
float rock_fan_rad() { return rocks.contact.z; }
float rock_min_m() { return rocks.contact.w; }
float film_solid_m() { return rocks.film.x; }
float theta() { return radians(params.waterfall.x); }
float ds() { return params.waterfall.y / sin(theta()) / params.cascade_params.y; }
float lane_width() { return params.waterfall.z / params.cascade_params.x; }
vec3 tangent() { return vec3(0.0, -sin(theta()), -cos(theta())); }
vec3 normal() { return vec3(0.0, cos(theta()), -sin(theta())); }
float ground_at(vec2 point) {
    ivec2 last = textureSize(ground_height, 0) - 1;
    float x = clamp((point.x - params.source_domain.x) / params.source_domain.z * float(last.x), 0.0, float(last.x));
    int row = 0;
    float f_y = 0.0;
    float first_z = texelFetch(ground_height, ivec2(0, 0), 0).g;
    float last_z = texelFetch(ground_height, ivec2(0, last.y), 0).g;
    if (point.y >= last_z) {
        row = last.y;
    } else if (point.y > first_z) {
        int low = 0;
        int high = last.y;
        for (int i = 0; i < 9; i++) {
            if (low < high) {
                int mid = (low + high) / 2;
                if (texelFetch(ground_height, ivec2(0, mid), 0).g < point.y) low = mid + 1;
                else high = mid;
            }
        }
        row = low - 1;
        float z0 = texelFetch(ground_height, ivec2(0, row), 0).g;
        float z1 = texelFetch(ground_height, ivec2(0, row + 1), 0).g;
        f_y = clamp((point.y - z0) / max(z1 - z0, 1.0e-8), 0.0, 1.0);
    }
    ivec2 lo = ivec2(int(floor(x)), row);
    vec2 f = vec2(fract(x), f_y);
    if (params.waterfall.x >= 90.0 && point.y < params.waterfall.w
            && texelFetch(ground_height, ivec2(0, min(row + 1, last.y)), 0).g >= params.waterfall.w) f.y = 0.0;
    float a = texelFetch(ground_height, lo, 0).r;
    float b = texelFetch(ground_height, min(lo + ivec2(1, 0), last), 0).r;
    float c = texelFetch(ground_height, min(lo + ivec2(0, 1), last), 0).r;
    float d = texelFetch(ground_height, min(lo + ivec2(1), last), 0).r;
    return f.x + f.y <= 1.0 ? a + (b - a) * f.x + (c - a) * f.y
        : d + (c - d) * (1.0 - f.x) + (b - d) * (1.0 - f.y);
}
float obstacle_excess(vec2 point) {
    ivec2 size = textureSize(obstacle_map, 0);
    vec2 cell = (point - params.source_domain.xy) / (params.source_domain.zw / vec2(size)) - 0.5;
    ivec2 lo = ivec2(floor(cell));
    vec2 f = cell - vec2(lo);
    ivec2 last = size - 1;
    float a = texelFetch(obstacle_map, clamp(lo, ivec2(0), last), 0).r;
    float b = texelFetch(obstacle_map, clamp(lo + ivec2(1, 0), ivec2(0), last), 0).r;
    float c = texelFetch(obstacle_map, clamp(lo + ivec2(0, 1), ivec2(0), last), 0).r;
    float d = texelFetch(obstacle_map, clamp(lo + ivec2(1, 1), ivec2(0), last), 0).r;
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}
float rock_ground_at(vec2 point) { return ground_at(point) + obstacle_excess(point); }
vec3 crest(int lane) {
    return vec3((float(lane) + 0.5) * lane_width() - params.waterfall.z * 0.5,
        params.waterfall.y - bed_depth_m(), params.waterfall.w);
}
vec4 film_state(ivec2 p) {
    p = clamp(p, ivec2(0), ivec2(params.cascade_params.xy) - 1);
    return control.words[19] == 0u ? imageLoad(film_a, p) : imageLoad(film_b, p);
}
void store_film(ivec2 p, vec4 q, bool current) {
    bool a = (control.words[19] == 0u) == current;
    if (a) imageStore(film_a, p, q); else imageStore(film_b, p, q);
}
float pool_height(vec2 world, bool next) {
    ivec2 p = clamp(ivec2(floor((world - params.domain.xy) / params.domain.z)),
        ivec2(0), ivec2(params.grid.xy) - 1);
    bool a = (control.words[19] == 0u) != next;
    vec4 q = a ? imageLoad(pool_a, p) : imageLoad(pool_b, p);
    return q.x > 0.02 ? imageLoad(terrain, p).x + q.x : params.water.x;
}
int last_film_row(int lane) {
    vec3 bottom = crest(lane) + tangent() * (params.waterfall.y / sin(theta()));
    float lower = pool_height(bottom.xz, false);
    return clamp(int(floor((params.waterfall.y - bed_depth_m() - lower) / sin(theta()) / ds())), 1,
        int(params.cascade_params.y) - 1);
}
vec2 film_velocity(vec4 q) {
    vec2 v = q.x > FILM_WET_M ? vec2(q.z, q.y) / q.x : vec2(0.0);
    float speed = length(v);
    return speed > FILM_MAX_SPEED_M_S ? v * (FILM_MAX_SPEED_M_S / speed) : v;
}
float film_bed(ivec2 p) {
    vec3 center = crest(p.x) + tangent() * ((float(p.y) + 0.5) * ds());
    return obstacle_excess(center.xz) * cos(theta());
}
// Hydrostatic reconstruction (Audusse et al. 2004) of the rock bed in slope coordinates:
// x across the crest, s down the slope, depth and bed measured along the slope normal.
vec4 film_face_flux(vec4 ql, vec4 qr, float bl, float br, vec2 n) {
    float gn = params.domain.w * cos(theta());
    float high = max(bl, br);
    float hl = max(ql.x + bl - high, 0.0);
    float hr = max(qr.x + br - high, 0.0);
    vec2 vl = film_velocity(ql);
    vec2 vr = film_velocity(qr);
    float nl = dot(vl, n);
    float nr = dot(vr, n);
    vec3 ul = vec3(hl, hl * vl);
    vec3 ur = vec3(hr, hr * vr);
    vec3 fl = vec3(hl * nl, hl * vl * nl + n * 0.5 * gn * hl * hl);
    vec3 fr = vec3(hr * nr, hr * vr * nr + n * 0.5 * gn * hr * hr);
    float cl = sqrt(gn * hl);
    float cr = sqrt(gn * hr);
    float sl = min(nl - cl, nr - cr);
    float sr = max(nl + cl, nr + cr);
    vec3 flux;
    if (sl >= 0.0) flux = fl;
    else if (sr <= 0.0) flux = fr;
    else flux = (sr * fl - sl * fr + sl * sr * (ur - ul)) / max(sr - sl, 1.0e-8);
    float concentration = flux.x >= 0.0 ? ql.w / max(ql.x, FILM_WET_M) : qr.w / max(qr.x, FILM_WET_M);
    flux.yz += n * 0.5 * gn * (ql.x * ql.x - hl * hl);
    return vec4(flux.x, flux.z, flux.y, flux.x * clamp(concentration, 0.0, 1.0));
}
vec4 film_wall_flux(vec4 q, vec2 n) {
    float pressure = 0.5 * params.domain.w * cos(theta()) * q.x * q.x;
    return vec4(0.0, n.y * pressure, n.x * pressure, 0.0);
}
void initialize(ivec2 p) {
    int lane = p.x;
    if (lane >= 48) return;
    if (p.y < 63) {
        imageStore(film_a, p, vec4(0.0));
        imageStore(film_b, p, vec4(0.0));
    }
    if (p.y == 0) {
        imageStore(boundary_out, ivec2(lane, 0), vec4(0.0));
        cascade.lane_input[lane] = vec4(0.0);
        cascade.arrivals[lane * 2] = vec4(0.0);
        cascade.arrivals[lane * 2 + 1] = vec4(0.0);
        cascade.totals[lane] = vec4(0.0);
        for (int i = 0; i < 256; ++i) {
            cascade.packets[(lane * 256 + i) * 2] = vec4(0.0);
            cascade.packets[(lane * 256 + i) * 2 + 1] = vec4(0.0);
        }
    }
}
void consume(ivec2 p) {
    if (p.x >= 48 || p.y != 0) return;
    int lane = p.x;
    cascade.totals[lane].y += cascade.arrivals[lane * 2].x;
    cascade.arrivals[lane * 2] = vec4(0.0);
    cascade.arrivals[lane * 2 + 1] = vec4(0.0);
    if (params.waterfall.x < 90.0) {
        vec4 inlet = cascade.lane_input[lane];
        vec4 q = film_state(p);
        float h = inlet.x / (ds() * lane_width());
        q.xyz += vec3(h, h * inlet.y, h * inlet.z);
        store_film(p, q, true);
        cascade.lane_input[lane] = vec4(0.0);
    }
}
// Rocks taller than the solid threshold are reflective walls (bow wave, dry wake) that
// seep, so pockets in their stair-stepped faces drain; lower rocks stay bed bumps.
vec4 film_neighbor_flux(vec4 q, float bed, ivec2 other, vec2 n) {
    float other_bed = film_bed(other);
    return other_bed > film_solid_m() ? film_wall_flux(q, n) + q * FILM_SEEPAGE_M_S
        : film_face_flux(q, film_state(other), bed, other_bed, n);
}
// A rock cell collects what its wet neighbours seep into it this step; the lane's
// row-0 thread hands that water to the receiving pool on the next step.
vec4 film_seepage(ivec2 p, int last, float dt) {
    vec4 gathered = vec4(0.0);
    if (p.y > last) return gathered;
    if (p.y > 0 && film_bed(p - ivec2(0, 1)) <= film_solid_m()) gathered += film_state(p - ivec2(0, 1)) * lane_width();
    if (p.y < last && film_bed(p + ivec2(0, 1)) <= film_solid_m()) gathered += film_state(p + ivec2(0, 1)) * lane_width();
    for (int side = -1; side <= 1; side += 2) {
        ivec2 other = p + ivec2(side, 0);
        if (other.x >= 0 && other.x < 48 && p.y <= last_film_row(other.x) && film_bed(other) <= film_solid_m())
            gathered += film_state(other) * ds();
    }
    return gathered * FILM_SEEPAGE_M_S * dt / (lane_width() * ds());
}
void step_film(ivec2 p) {
    if (p.x >= 48 || p.y >= 63) return;
    int last = last_film_row(p.x);
    float dt = uintBitsToFloat(control.words[3]);
    if (p.y == 0) {
        vec4 exit = film_state(ivec2(p.x, last));
        vec2 exit_velocity = film_velocity(exit);
        float volume = film_bed(ivec2(p.x, last)) > film_solid_m() ? 0.0 : max(exit.y, 0.0) * lane_width() * dt;
        vec2 momentum = vec2(exit_velocity.x, -cos(theta()) * exit_velocity.y) * volume;
        float foam = volume * clamp(exit.w / max(exit.x, FILM_WET_M), 0.0, 1.0);
        for (int row = 0; row < 63; ++row) {
            if (row <= last && film_bed(ivec2(p.x, row)) <= film_solid_m()) continue;
            vec4 tail = film_state(ivec2(p.x, row));
            volume += tail.x * ds() * lane_width();
            momentum += vec2(tail.z, -cos(theta()) * tail.y) * ds() * lane_width();
            foam += tail.w * ds() * lane_width();
        }
        vec3 point = crest(p.x) + tangent() * (float(last + 1) * ds());
        float run = max(params.waterfall.y - bed_depth_m() - params.water.x, 0.0) / tan(theta());
        float receiver = params.waterfall.w - max(run, params.domain.z);
        float z = min(point.z, receiver - params.domain.z);
        float speed_foam = clamp(exit_velocity.y / 8.0, 0.0, 1.0);
        cascade.arrivals[p.x * 2] = vec4(volume, z, point.x, 1.0);
        cascade.arrivals[p.x * 2 + 1] = vec4(momentum / max(volume, 1.0e-12),
            max(speed_foam, foam / max(volume, 1.0e-12)), 0.0);
    }
    float bed = film_bed(p);
    if (p.y > last) { store_film(p, vec4(0.0), false); return; }
    if (bed > film_solid_m()) { store_film(p, film_seepage(p, last, dt), false); return; }
    vec4 q = film_state(p);
    vec4 up = p.y > 0 ? film_neighbor_flux(q, bed, p - ivec2(0, 1), vec2(0.0, -1.0)) : vec4(0.0);
    vec4 down;
    if (p.y < last) {
        down = film_neighbor_flux(q, bed, p + ivec2(0, 1), vec2(0.0, 1.0));
    } else {
        vec2 v = film_velocity(q);
        float discharge = max(q.y, 0.0);
        down = vec4(discharge, discharge * v.y, discharge * v.x, discharge * clamp(q.w / max(q.x, FILM_WET_M), 0.0, 1.0));
    }
    ivec2 west_cell = p - ivec2(1, 0);
    ivec2 east_cell = p + ivec2(1, 0);
    vec4 west = p.x > 0 && p.y <= last_film_row(west_cell.x)
        ? film_neighbor_flux(q, bed, west_cell, vec2(-1.0, 0.0)) : film_wall_flux(q, vec2(-1.0, 0.0));
    vec4 east = p.x < 47 && p.y <= last_film_row(east_cell.x)
        ? film_neighbor_flux(q, bed, east_cell, vec2(1.0, 0.0)) : film_wall_flux(q, vec2(1.0, 0.0));
    vec2 velocity = film_velocity(q);
    vec2 north_velocity = film_velocity(film_state(p - ivec2(0, 1)));
    vec2 south_velocity = film_velocity(film_state(p + ivec2(0, 1)));
    vec2 gradient = vec2(film_bed(ivec2(min(p.x + 1, 47), p.y)) - film_bed(ivec2(max(p.x - 1, 0), p.y)),
        film_bed(p + ivec2(0, 1)) - film_bed(p - ivec2(0, 1))) / vec2(2.0 * lane_width(), 2.0 * ds());
    float climb = max(dot(velocity, gradient), 0.0);
    float compression = max(-(film_velocity(film_state(east_cell)).x - film_velocity(film_state(west_cell)).x) / (2.0 * lane_width())
        - (south_velocity.y - north_velocity.y) / (2.0 * ds()), 0.0);
    q -= dt / lane_width() * (east + west) + dt / ds() * (up + down);
    q.x = max(q.x, 0.0);
    q.y += dt * params.domain.w * sin(theta()) * q.x;
    q.yz /= 1.0 + dt * 0.08;
    if (q.x < 0.000001) q.yzw = vec3(0.0);
    else {
        float source = clamp(climb * 1.5 + compression * 0.05, 0.0, 6.0) * smoothstep(0.002, 0.01, q.x);
        float foam = clamp(q.w / q.x, 0.0, 1.0) * exp(-dt * 0.5);
        q.w = (1.0 - (1.0 - foam) * exp(-source * dt)) * q.x;
    }
    store_film(p, q, false);
}
void step_ballistic(ivec2 p) {
    if (p.x >= 48 || p.y != 0) return;
    int lane = p.x;
    float dt = uintBitsToFloat(control.words[3]);
    float g = params.domain.w;
    vec4 arrival = vec4(0.0);
    vec2 momentum = vec2(0.0);
    for (int i = 0; i < 256; ++i) {
        int slot = (lane * 256 + i) * 2;
        vec4 packet = cascade.packets[slot];
        vec4 state = cascade.packets[slot + 1];
        if (packet.x <= 0.0) continue;
        vec3 velocity = vec3(state.y, packet.w, state.w);
        vec3 previous = vec3(state.x, packet.z, state.z);
        vec3 point = previous + velocity * dt - vec3(0.0, 0.5 * g * dt * dt, 0.0);
        velocity.y -= g * dt;
        float age = packet.y + dt;
        vec2 impact_xz = vec2(point.x, min(point.z, params.waterfall.w - params.domain.z * 1.5));
        float rock = obstacle_excess(point.xz);
        float surface = ground_at(point.xz) + rock;
        bool landed = point.y <= pool_height(impact_xz, true) || age > PACKET_MAX_AGE_S;
        if (!landed && point.y < surface + 0.01) {
            if (rock > rock_min_m()) {
                if (surface + 0.01 - point.y > max(0.3, 2.0 * length(velocity) * dt)) {
                    vec2 slope = vec2(rock_ground_at(previous.xz + vec2(0.0625, 0.0)) - rock_ground_at(previous.xz - vec2(0.0625, 0.0)),
                        rock_ground_at(previous.xz + vec2(0.0, 0.0625)) - rock_ground_at(previous.xz - vec2(0.0, 0.0625)));
                    vec2 wall = length(slope) > 1.0e-6 ? -normalize(slope) : -normalize(velocity.xz + vec2(1.0e-6));
                    float into = dot(velocity.xz, wall);
                    if (into < 0.0) velocity.xz -= wall * into * (1.0 + rock_restitution());
                    point = vec3(previous.x, point.y, previous.z);
                    surface = rock_ground_at(point.xz);
                }
                vec3 normal = normalize(vec3(
                    obstacle_excess(point.xz - vec2(0.0625, 0.0)) - obstacle_excess(point.xz + vec2(0.0625, 0.0)), 0.125,
                    obstacle_excess(point.xz - vec2(0.0, 0.0625)) - obstacle_excess(point.xz + vec2(0.0, 0.0625))));
                float into = dot(velocity, normal);
                vec3 along = velocity - normal * into;
                if (into < 0.0) {
                    vec3 downhill = vec3(0.0, -1.0, 0.0) - normal * -normal.y;
                    vec3 direction = length(along) > 0.05 ? normalize(along)
                        : (length(downhill) > 1.0e-4 ? normalize(downhill) : normalize(cross(normal, vec3(1.0, 0.0, 0.0))));
                    float fan = (fract(float(i) * 0.6180339 + float(lane) * 0.137) - 0.5) * 2.0 * rock_fan_rad()
                        * smoothstep(0.5, 2.0, -into);
                    direction = direction * cos(fan) + cross(normal, direction) * sin(fan);
                    velocity = direction * (length(along) - into * rock_spread()) - normal * into * rock_restitution();
                } else velocity -= along * (1.0 - exp(-dt * ROCK_FRICTION_HZ));
                point.y = max(point.y, surface + 0.011);
            } else landed = true;
        }
        if (landed) {
            arrival.x += packet.x;
            arrival.yz += packet.x * impact_xz.yx;
            momentum += packet.x * velocity.xz;
            packet.x = -packet.x;
        }
        cascade.packets[slot] = vec4(packet.x, age, point.y, velocity.y);
        cascade.packets[slot + 1] = vec4(point.x, velocity.x, point.z, velocity.z);
    }
    if (arrival.x > 0.0) {
        arrival.yz /= arrival.x;
        arrival.w = 1.0;
        cascade.arrivals[lane * 2] = arrival;
        cascade.arrivals[lane * 2 + 1] = vec4(momentum / arrival.x, 1.0, 0.0);
    }
    if (control.words[8] != 0u) {
        int slot = (lane * 256 + int(control.words[4])) * 2;
        vec4 inlet = cascade.lane_input[lane];
        if (cascade.packets[slot].x <= 0.0) {
            float lift = rock_ground_at(vec2(crest(lane).x, params.waterfall.w)) + 0.011;
            cascade.packets[slot] = vec4(inlet.x, 0.0, max(inlet.w, lift), 0.0);
            cascade.packets[slot + 1] = vec4(crest(lane).x, inlet.z, params.waterfall.w, -inlet.y);
            cascade.lane_input[lane] = vec4(0.0);
        } else if (inlet.x > 0.0) atomicAdd(control.words[17], 1u);
    }
}
void publish(ivec2 p) {
    int capacity = params.waterfall.x >= 90.0 ? 256 : 63;
    if (p.x >= 48 || p.y >= capacity) return;
    vec3 point, velocity;
    float depth = 0.0, activity = 0.0;
    if (params.waterfall.x < 90.0) {
        vec4 q = film_state(p);
        vec2 v = film_velocity(q);
        point = crest(p.x) + tangent() * ((float(p.y) + 0.5) * ds());
        point.y = rock_ground_at(point.xz) + 0.011;
        velocity = tangent() * v.y + vec3(v.x, 0.0, 0.0);
        depth = q.x;
        activity = q.x > 0.000001 ? clamp(q.w / q.x, 0.0, 1.0) : 0.0;
    } else {
        int slot = (p.x * 256 + p.y) * 2;
        vec4 packet = cascade.packets[slot];
        vec4 state = cascade.packets[slot + 1];
        point = vec3(state.x, packet.z, state.z);
        velocity = vec3(state.y, packet.w, state.w);
        depth = max(packet.x, 0.0) / max(lane_width() * max(length(velocity), 0.2) / params.cascade_params.w, 1.0e-6);
        activity = abs(packet.x) / max(lane_width() * max(length(velocity), 0.2) / params.cascade_params.w, 1.0e-6);
    }
    imageStore(surface_out, p, vec4(point, depth));
    imageStore(velocity_out, p, vec4(velocity, activity));
    if (p.y == 0) {
        int lane = p.x;
        vec2 source = vec2(crest(lane).x, params.waterfall.w + 0.5 * params.domain.z);
        ivec2 source_cell = clamp(ivec2(floor((source - params.domain.xy) / params.domain.z)),
            ivec2(0), ivec2(params.grid.xy) - 1);
        bool pool_is_a = control.words[19] == 0u;
        vec4 source_state = pool_is_a ? imageLoad(pool_a, source_cell) : imageLoad(pool_b, source_cell);
        float source_height = source_state.x > 0.02
            ? imageLoad(terrain, source_cell).x + source_state.x : params.water.x;
        vec2 source_velocity = source_state.x > 0.004 ? source_state.yz / source_state.x : vec2(0.0);
        float receiver = params.waterfall.w - max((params.waterfall.y - bed_depth_m() - params.water.x)
            / max(tan(theta()), 1.0e-8), params.domain.z);
        vec2 receiver_point = vec2(source.x, receiver);
        float film_end = params.waterfall.y;
        if (params.waterfall.x < 90.0) {
            int last = last_film_row(lane);
            film_end = float(last + 1) * ds();
            receiver = min(params.waterfall.w - film_end * cos(theta()), receiver - params.domain.z);
            receiver_point.y = receiver;
        } else {
            float time = sqrt(2.0 * max(source_height - params.water.x, 0.0) / params.domain.w);
            for (int i = 0; i < 4; ++i) {
                receiver_point = vec2(source.x, params.waterfall.w) + source_velocity * time;
                ivec2 target_cell = clamp(ivec2(floor((receiver_point - params.domain.xy) / params.domain.z)),
                    ivec2(0), ivec2(params.grid.xy) - 1);
                bool target_is_a = control.words[19] == 0u;
                vec4 target_state = target_is_a ? imageLoad(pool_a, target_cell) : imageLoad(pool_b, target_cell);
                float target_height = target_state.x > 0.02
                    ? imageLoad(terrain, target_cell).x + target_state.x : params.water.x;
                time = sqrt(2.0 * max(source_height - target_height, 0.0) / params.domain.w);
            }
            receiver_point = vec2(source.x, params.waterfall.w) + source_velocity * time;
            receiver = min(receiver_point.y, params.waterfall.w - params.domain.z * 1.5);
            receiver_point.y = receiver;
        }
        ivec2 receiver_cell = clamp(ivec2(floor((receiver_point - params.domain.xy) / params.domain.z)),
            ivec2(0), ivec2(params.grid.xy) - 1);
        bool receiver_is_a = control.words[19] == 0u;
        vec4 receiver_state = receiver_is_a ? imageLoad(pool_a, receiver_cell) : imageLoad(pool_b, receiver_cell);
        float receiver_height = receiver_state.x > 0.02
            ? imageLoad(terrain, receiver_cell).x + receiver_state.x : params.water.x;
        imageStore(boundary_out, ivec2(lane, 0), vec4(source_height, film_end, receiver, receiver_height));
        float transported = cascade.lane_input[lane].x + cascade.arrivals[lane * 2].x;
        if (params.waterfall.x < 90.0) {
            for (int row = 0; row < 63; ++row) transported += film_state(ivec2(lane, row)).x * ds() * lane_width();
        } else {
            for (int i = 0; i < 256; ++i) transported += max(cascade.packets[(lane * 256 + i) * 2].x, 0.0);
        }
        cascade.totals[lane].z = transported;
    }
}
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (params.control_params.x > 3.5) {
        if (all(equal(p, ivec2(0)))) {
            vec3 total = vec3(0.0);
            for (int lane = 0; lane < 48; ++lane) total += cascade.totals[lane].xyz;
            control.words[6] = floatBitsToUint(total.x);
            control.words[7] = floatBitsToUint(total.y);
            control.words[20] = floatBitsToUint(total.z);
        }
        return;
    }
    if (params.control_params.x < 0.5) initialize(p);
    else if (params.control_params.x > 2.5) consume(p);
    else if (params.control_params.x < 1.5) {
        if (params.waterfall.x < 90.0) step_film(p); else step_ballistic(p);
    } else publish(p);
}
