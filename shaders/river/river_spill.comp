#version 450

// Water that spilled over a steep bed edge, carried as ballistic particles until it lands back on the grid.
layout(local_size_x = 64) in;

layout(rgba32f, set = 0, binding = 0) uniform readonly image2D terrain;
layout(rgba32f, set = 0, binding = 1) uniform readonly image2D state;
// Per particle: position + volume units, velocity + age, emission cell index + foam share of the water it left (SLID
// once it slid down a face) + height it last left the ground at + emission height.
layout(std430, set = 0, binding = 2) buffer Particles { vec4 data[]; } particles;
layout(std430, set = 0, binding = 3) buffer SpillDeposits { int deposits[]; } spill_deposits;
layout(std430, set = 0, binding = 4) buffer SpillOutflow { vec4 outflow[]; } spill_outflow;
// Words: 0 slot counter, 2-3 emitted, 4-5 deposited, 6-7 left the domain, 8-9 overwritten (low, high),
// 12 spill slope, 13 volume unit in m3, 14 emitted particle count, 17 listed spilling faces.
layout(std430, set = 0, binding = 5) buffer SpillState { uint words[]; } spill;
// Drawn particles: position and distance along break-up (thinned free-fall drop plus aerated share of it), 0 when unused.
layout(rgba32f, set = 0, binding = 6) uniform writeonly image2D positions;
// Per impact tile: water landings then hits on dry ground, each as weight (volume units over impact.z),
// weighted x and z velocity, weighted height. A landing weighs in by its drop, ramping over spray.xy metres.
layout(std430, set = 0, binding = 7) buffer Impacts { int tiles[]; } impacts;
// Drawn particles: velocity and the share of the reference stream's radius its volume gives it, 0 when unused.
layout(rgba32f, set = 0, binding = 8) uniform writeonly image2D motion;
// Per cell: bits 0-3 the faces it spills over, and in w its settled level (see river_swe.comp).
layout(rgba32f, set = 0, binding = 9) uniform readonly image2D spill_faces;
// Spilling faces of wet cells the sheets draw, refilled every frame: cell index, face + 1 (0 = unused).
layout(rgba32f, set = 0, binding = 10) uniform image2D lips;
// Per cell while it spills: brink velocity x and z its particles leave at, then its nappe_share.
layout(rgba32f, set = 0, binding = 11) uniform image2D lip_flow;
layout(push_constant, std430) uniform Params {
    vec4 domain;
    vec4 grid;
    vec4 motion;
    vec4 impact;
    vec4 spray;
    // Break-up length (x), Froude numbers of the water reaching a lip over which it stops leaving as a nappe (y, z).
    vec4 breakup;
    // Largest thinning (w).
    vec4 sheet;
    // Mean clearance over drop from a jet along a slope to a free fall (x, y).
    vec4 fall;
} params;

const float WET_DEPTH_M = 0.004;
// A particle leaves this far past the face it spills over.
const float SPILL_CLEARANCE_M = 0.02;
// The drawn drop starts above zero so a particle that just left the ground is not taken for an unused slot.
const float DROP_OFFSET_M = 0.01;
// Time step and steps of the path traced from a lip to where its water lands.
const float LANDING_STEP_S = 0.02;
const int LANDING_STEPS = 100;
// Above any foam share: marks water that slid down a face.
const float SLID = 2.0;
// Landed water spreads over cells within this radius, in a DEPOSIT_SPAN-wide square around its cell.
const float DEPOSIT_RADIUS_CELLS = 2.5;
const int DEPOSIT_SPAN = 5;
const int DEPOSIT_CELLS = DEPOSIT_SPAN * DEPOSIT_SPAN;
// Share of a landing's downward speed turned outward along the pool (MAX_ARRIVAL_SPEED_M_S in river_swe.comp caps it).
const float PLUNGE_REDIRECT = 0.5;

void ledger_add(int index, uint units) {
    uint old = atomicAdd(spill.words[index], units);
    if (old > 0xFFFFFFFFu - units) atomicAdd(spill.words[index + 1], 1u);
}

float bed_at(ivec2 cell) {
    return imageLoad(terrain, clamp(cell, ivec2(0), ivec2(params.grid.xy) - 1)).x;
}

// Bilinear bed height and its gradient at a position in cell units.
vec3 ground(vec2 cell) {
    vec2 c = cell - 0.5;
    ivec2 lo = ivec2(floor(c));
    vec2 f = c - vec2(lo);
    float a = bed_at(lo);
    float b = bed_at(lo + ivec2(1, 0));
    float d = bed_at(lo + ivec2(0, 1));
    float e = bed_at(lo + ivec2(1, 1));
    float height = mix(mix(a, b, f.x), mix(d, e, f.x), f.y);
    vec2 gradient = vec2(mix(b - a, e - d, f.y), mix(d - a, e - b, f.x)) / params.domain.z;
    return vec3(height, gradient);
}

void record_impact(vec3 position, vec3 velocity, float units, int kind) {
    int columns = int(ceil(params.grid.x * params.domain.z / params.impact.x));
    ivec2 tile = ivec2(floor((position.xz - params.domain.xy) / params.impact.x));
    int base = (tile.y * columns + tile.x) * 8 + kind * 4;
    float weight = units / params.impact.z;
    if (weight < 0.5) return;
    atomicAdd(impacts.tiles[base], int(round(weight)));
    atomicAdd(impacts.tiles[base + 1], int(round(weight * velocity.x)));
    atomicAdd(impacts.tiles[base + 2], int(round(weight * velocity.z)));
    atomicAdd(impacts.tiles[base + 3], int(round(weight * position.y)));
}

void deposit_cell(ivec2 cell, float units, vec3 velocity) {
    int index = cell.y * int(params.grid.x) + cell.x;
    atomicAdd(spill_deposits.deposits[index * 4], int(units));
    atomicAdd(spill_deposits.deposits[index * 4 + 1], int(round(units * velocity.x)));
    atomicAdd(spill_deposits.deposits[index * 4 + 2], int(round(units * velocity.z)));
}

// Tent-weighted over wet-able cells within DEPOSIT_RADIUS_CELLS (a one-cell deposit piles a mound), plunge speed turned outward.
void deposit(vec2 cell_position, float surface, float units, vec3 velocity) {
    ivec2 center = ivec2(floor(cell_position));
    float share[DEPOSIT_CELLS];
    float total = 0.0;
    int largest = 0;
    for (int k = 0; k < DEPOSIT_CELLS; ++k) {
        ivec2 n = center + ivec2(k % DEPOSIT_SPAN, k / DEPOSIT_SPAN) - DEPOSIT_SPAN / 2;
        bool inside = all(greaterThanEqual(n, ivec2(0))) && all(lessThan(n, ivec2(params.grid.xy)));
        float distance = length(vec2(n) + 0.5 - cell_position);
        share[k] = inside && bed_at(n) <= surface ? max(1.0 - distance / DEPOSIT_RADIUS_CELLS, 0.0) : 0.0;
        total += share[k];
        if (share[k] > share[largest]) largest = k;
    }
    float left = units;
    float outward = PLUNGE_REDIRECT * max(-velocity.y, 0.0);
    for (int k = 0; k < DEPOSIT_CELLS; ++k) {
        if (share[k] <= 0.0) continue;
        ivec2 n = center + ivec2(k % DEPOSIT_SPAN, k / DEPOSIT_SPAN) - DEPOSIT_SPAN / 2;
        vec2 away = vec2(n) + 0.5 - cell_position;
        vec2 radial = length(away) > 0.01 ? normalize(away) * outward : vec2(0.0);
        float part = k == largest ? 0.0 : floor(units * share[k] / total);
        left -= part;
        if (part > 0.0) deposit_cell(n, part, velocity + vec3(radial.x, 0.0, radial.y));
    }
    ivec2 n = center + ivec2(largest % DEPOSIT_SPAN, largest / DEPOSIT_SPAN) - DEPOSIT_SPAN / 2;
    vec2 away = vec2(n) + 0.5 - cell_position;
    vec2 radial = length(away) > 0.01 ? normalize(away) * outward : vec2(0.0);
    deposit_cell(n, left, velocity + vec3(radial.x, 0.0, radial.y));
    ledger_add(4, uint(units));
}

void integrate(uint i) {
    vec4 body = particles.data[i * 3u];
    if (body.w <= 0.0) return;
    vec4 motion = particles.data[i * 3u + 1u];
    float dt = params.grid.z;
    motion.y -= params.domain.w * dt;
    body.xyz += motion.xyz * dt;
    motion.w += dt;
    vec2 cell_position = (body.xz - params.domain.xy) / params.domain.z;
    ivec2 cell = ivec2(floor(cell_position));
    if (any(lessThan(cell, ivec2(0))) || any(greaterThanEqual(cell, ivec2(params.grid.xy)))) {
        ledger_add(6, uint(body.w));
        particles.data[i * 3u].w = 0.0;
        return;
    }
    float depth = imageLoad(state, cell).x;
    // At the pool's settled level, not its surface: the boil and troughs earlier landings raise must not time this one.
    bool wet = depth > WET_DEPTH_M && body.y <= max(imageLoad(spill_faces, cell).w, bed_at(cell));
    bool landed = wet || motion.w > params.motion.y;
    vec3 bed = ground(cell_position);
    if (!landed && body.y <= bed.x) {
        vec3 normal = normalize(vec3(-bed.y, 1.0, -bed.z));
        if (-dot(motion.xyz, normal) > params.impact.y) record_impact(body.xyz, motion.xyz, body.w, 1);
        // Gentle ground keeps the water; a face steeper than the spill slope lets it slide down.
        if (length(bed.yz) < uintBitsToFloat(spill.words[12])) {
            landed = true;
        } else {
            body.y = bed.x;
            motion.xyz -= normal * min(dot(motion.xyz, normal), 0.0);
            motion.xyz *= exp(-params.motion.x * dt);
            particles.data[i * 3u + 2u].yz = vec2(SLID, body.y);
        }
    }
    if (landed) {
        float drop = particles.data[i * 3u + 2u].z - body.y;
        if (wet) record_impact(body.xyz, motion.xyz, body.w * smoothstep(params.spray.x, params.spray.y, drop), 0);
        deposit(cell_position, bed_at(cell) + depth, body.w, motion.xyz);
        particles.data[i * 3u].w = 0.0;
        return;
    }
    particles.data[i * 3u] = body;
    particles.data[i * 3u + 1u] = motion;
}

uint hash(uint value) {
    value = value * 747796405u + 2891336453u;
    value = ((value >> ((value >> 28u) + 4u)) ^ value) * 277803737u;
    return (value >> 22u) ^ value;
}

// One particle per spilling cell and emission period, in whole volume units; the remainder waits for the next one.
// It leaves over a face picked in proportion to the volume over it, from a point drawn uniformly across the face
// (Chentanez & Mueller), with a random sideways share motion.w of its speed. It leaves at the water surface: drawn
// at random heights, the particles of a stream lose their even spacing down the fall and the sheet tears open.
void emit(uint index) {
    vec4 sums = spill_outflow.outflow[index * 2u];
    if (sums.x <= 0.0) return;
    float unit = uintBitsToFloat(spill.words[13]);
    float units = floor(sums.x / unit);
    if (units < 1.0) return;
    vec4 faces = spill_outflow.outflow[index * 2u + 1u];
    float kept = 1.0 - units * unit / sums.x;
    spill_outflow.outflow[index * 2u] = sums * kept;
    spill_outflow.outflow[index * 2u + 1u] = faces * kept;
    uint slot = atomicAdd(spill.words[0], 1u) % uint(params.grid.w);
    float replaced = particles.data[slot * 3u].w;
    if (replaced > 0.0) ledger_add(8, uint(replaced));
    ivec2 cell = ivec2(int(index % uint(params.grid.x)), int(index / uint(params.grid.x)));
    vec4 source = imageLoad(state, cell);
    uint seed = hash(spill.words[14] + index * 9781u);
    float pick = float(hash(seed) & 0xFFFFu) / 65535.0 * dot(faces, vec4(1.0));
    int face = 0;
    while (face < 3 && pick > faces[face]) {
        pick -= faces[face];
        face++;
    }
    vec2 normal = face < 2 ? vec2(float(1 - 2 * face), 0.0) : vec2(0.0, float(5 - 2 * face));
    // Along the face from a random point, clear of the cell it leaves.
    vec2 jitter = vec2(hash(slot * 2u + 1u) & 0xFFFFu, hash(slot * 2u + 2u) & 0xFFFFu) / 65535.0;
    vec2 point = params.domain.xy + (vec2(cell) + 0.5) * params.domain.z
        + normal * (0.5 * params.domain.z + SPILL_CLEARANCE_M) + (jitter - 0.5) * params.domain.z * abs(normal.yx);
    vec3 position = vec3(point.x, bed_at(cell) + source.x, point.y);
    particles.data[slot * 3u] = vec4(position, units);
    vec2 velocity = sums.yz / sums.x;
    float angle = float(seed & 0xFFFFu) / 65535.0 * 6.2831853;
    float share = float(seed >> 16u) / 65535.0 * params.motion.w;
    velocity += vec2(cos(angle), sin(angle)) * share * length(velocity);
    particles.data[slot * 3u + 1u] = vec4(velocity.x, 0.0, velocity.y, 0.0);
    particles.data[slot * 3u + 2u] = vec4(float(index), clamp(source.w / max(source.x, WET_DEPTH_M), 0.0, 1.0), position.y, position.y);
    ledger_add(2, uint(units));
    atomicAdd(spill.words[14], 1u);
}

void draw(uint i) {
    int width = imageSize(positions).x;
    vec4 body = particles.data[i * 3u];
    vec4 origin = particles.data[i * 3u + 2u];
    float drop = max(origin.z - body.y, 0.0);
    float thinning = body.w > 0.0 ? pow(clamp(params.spray.z / body.w, 1.0, params.sheet.w), params.spray.w) : 1.0;
    uint emitted_from = uint(origin.x);
    float nappe = imageLoad(lip_flow, ivec2(int(emitted_from % uint(params.grid.x)), int(emitted_from / uint(params.grid.x)))).z;
    float aerated = max(origin.y, 1.0 - nappe);
    float look = origin.y >= SLID ? params.breakup.x + max(origin.w - body.y, 0.0) : drop * thinning + aerated * params.breakup.x;
    ivec2 texel = ivec2(int(i) % width, int(i) / width);
    imageStore(positions, texel, body.w > 0.0 ? vec4(body.xyz, look + DROP_OFFSET_M) : vec4(0.0));
    float radius = params.spray.z > 0.0 ? min(sqrt(body.w / params.spray.z), 1.0) : 1.0;
    imageStore(motion, texel, body.w > 0.0 ? vec4(particles.data[i * 3u + 1u].xyz, radius) : vec4(0.0));
}

// Share of its water leaving as a smooth nappe clear of the ground; a torrent or a jet along a slope leaves aerated.
float nappe_share(uint index, ivec2 cell, int faces, vec2 velocity, vec4 source) {
    float depth = source.x;
    float froude = length(source.yz) / depth / sqrt(params.domain.w * depth);
    vec4 volumes = spill_outflow.outflow[index * 2u + 1u];
    int face = 0;
    float largest = -1.0;
    for (int k = 0; k < 4; ++k) {
        if ((faces & (1 << k)) != 0 && volumes[k] > largest) {
            largest = volumes[k];
            face = k;
        }
    }
    vec2 normal = face < 2 ? vec2(float(1 - 2 * face), 0.0) : vec2(0.0, float(5 - 2 * face));
    vec2 start = params.domain.xy + (vec2(cell) + 0.5 + 0.5 * normal) * params.domain.z + normal * SPILL_CLEARANCE_M;
    float top = bed_at(cell) + depth;
    float clearance = 0.0;
    for (int step = 1; step <= LANDING_STEPS; ++step) {
        float time_s = float(step) * LANDING_STEP_S;
        ivec2 under = ivec2(floor((start + velocity * time_s - params.domain.xy) / params.domain.z));
        if (any(lessThan(under, ivec2(0))) || any(greaterThanEqual(under, ivec2(params.grid.xy)))) break;
        float landing = bed_at(under) + imageLoad(state, under).x;
        float height = top - 0.5 * params.domain.w * time_s * time_s - landing;
        if (height > 0.0) {
            clearance += height;
            continue;
        }
        return (1.0 - smoothstep(params.breakup.y, params.breakup.z, froude))
            * smoothstep(params.fall.x, params.fall.y, clearance / float(step) / max(top - landing, 0.01));
    }
    return 1.0 - smoothstep(params.breakup.y, params.breakup.z, froude);
}

// Every frame: list each spilling face of a wet cell for the sheets and refresh that cell's lip_flow.
void list_lips(uint index) {
    ivec2 cell = ivec2(int(index % uint(params.grid.x)), int(index / uint(params.grid.x)));
    int faces = int(imageLoad(spill_faces, cell).r + 0.5) & 15;
    if (faces == 0) return;
    vec4 source = imageLoad(state, cell);
    if (source.x <= WET_DEPTH_M) {
        // A wall cell passes on water that has already hit its rock: none of it leaves as a smooth nappe.
        imageStore(lip_flow, cell, vec4(0.0));
        return;
    }
    vec4 sums = spill_outflow.outflow[index * 2u];
    vec2 velocity = sums.x > 0.0 ? sums.yz / sums.x : imageLoad(lip_flow, cell).xy;
    imageStore(lip_flow, cell, vec4(velocity, nappe_share(index, cell, faces, velocity, source), 0.0));
    ivec2 size = imageSize(lips);
    for (int face = 0; face < 4; ++face) {
        if ((faces & (1 << face)) == 0) continue;
        uint slot = atomicAdd(spill.words[17], 1u);
        if (slot >= uint(size.x * size.y)) return;
        imageStore(lips, ivec2(int(slot) % size.x, int(slot) / size.x), vec4(float(index), float(face + 1), 0.0, 0.0));
    }
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (params.motion.z < 0.5) {
        if (i < uint(params.grid.w)) integrate(i);
    } else if (params.motion.z < 1.5) {
        if (i < uint(params.grid.x * params.grid.y)) emit(i);
    } else if (params.motion.z < 2.5) {
        // The list is refilled after this pass.
        ivec2 size = imageSize(lips);
        if (i == 0u) spill.words[17] = 0u;
        if (i < uint(size.x * size.y)) imageStore(lips, ivec2(int(i) % size.x, int(i) / size.x), vec4(0.0));
        if (i < uint(params.grid.w)) draw(i);
    } else if (i < uint(params.grid.x * params.grid.y)) {
        list_lips(i);
    }
}
