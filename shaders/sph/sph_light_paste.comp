// Light Paste is a Bingham plug. A particle resting on a collider, or touching
// paste that already stopped, is supported: its velocity loses up to the yield
// deceleration (params.sim2.w, m/s^2) every sub-step, so anything pushed softer
// than the yield stops dead and in turn supports the paste above it. Piles keep
// their relief; shoves harder than the yield flow. Unsupported paste falls
// freely. positions.w carries the render glow (0..1) plus PASTE_ANCHORED while
// the particle is stuck.
const float PASTE_ANCHORED = 2.0;
const float PASTE_VISCOUS_RATE = 40.0;
const float PASTE_GLOW_RESPONSE = 0.25;

vec3 paste_viscosity(uint i, vec3 pos, out bool supported) {
	vec3 v = velocities_snap.data[i].xyz;
	supported = positions.data[i].w >= PASTE_ANCHORED;
	vec3 sum = vec3(0.0);
	float weight_sum = 0.0;
	FOREACH_NEIGHBOR(pos,
		vec3 off = predicted.data[j].xyz - pos;
		float r2 = dot(off, off);
		if (j == i || r2 >= params.kernel.y) {
			continue;
		}
		float weight = sph_poly6(r2);
		sum += velocities_snap.data[j].xyz * weight;
		weight_sum += weight;
		supported = supported || positions.data[j].w >= PASTE_ANCHORED;
	)
	if (weight_sum <= 0.0) {
		return v;
	}
	vec3 mean = sum / weight_sum;
	return mean + (v - mean) * exp(-PASTE_VISCOUS_RATE * params.sim2.x * params.sim.x);
}

vec3 paste_yield(vec3 v) {
	return v * max(0.0, 1.0 - params.sim2.w * params.sim.x / max(length(v), 1e-6));
}
