void main() {
	uint i = gl_GlobalInvocationID.x;
	if (i >= uint(params.grid_dims.w)) {
		return;
	}
	vec3 pos = predicted.data[i].xyz;
	float density = densities.data[i];
	float near_density = near_densities.data[i];
	float stiffness_scale = scene.fluid_material.y;
	float pressure = (density - params.sim.y) * params.sim.z * stiffness_scale;
	float near_pressure = near_density * params.sim.w * stiffness_scale;
	vec3 vel_i = velocities.data[i].xyz;
	vec3 force = vec3(0.0);
	vec3 near_force = vec3(0.0);
	vec3 surface_force = vec3(0.0);
	float cohesion = params.sim2.z;
	float phase = positions.data[i].w;
	vec3 extension = vec3(0.0);
	vec3 elastic_force = vec3(0.0);
	vec4 reference = vec4(0.0);
	if (params.material == MATERIAL_SPECTRAL_GEL) {
		reference = gel_reference.data[uint(round(velocities_snap.data[i].w))];
	}
	int neighbours = 0;
	bool nitrogen = params.material == MATERIAL_LIQUID_NITROGEN;
	bool spawn_foam = foam.flags.x == 1 && (params.material == MATERIAL_WATER || nitrogen);
	// Trapped-air metric (Ihmsen et al. / SebLague): how strongly this particle
	// converges with its neighbours. High only where fluid slams into itself,
	// which is exactly where air is entrained and foam is born.
	float trapped_air = 0.0;
	FOREACH_NEIGHBOR(pos,
		if (j == i) {
			continue;
		}
		vec3 off = predicted.data[j].xyz - pos;
		float r2 = dot(off, off);
		if (r2 >= params.kernel.y) {
			continue;
		}
		neighbours++;
		float dst = sqrt(r2);
		vec3 dir = dst > 1e-6 ? off / dst : vec3(0.0, 1.0, 0.0);
		float dj = densities.data[j];
		float nj = near_densities.data[j];
		float pj = (dj - params.sim.y) * params.sim.z * stiffness_scale;
		float npj = nj * params.sim.w * stiffness_scale;
		float shared_p = (pressure + pj) * 0.5;
		float shared_np = (near_pressure + npj) * 0.5;
		force += dir * sph_density_deriv(dst) * shared_p / dj;
		near_force += dir * sph_near_density_deriv(dst) * shared_np / nj;
		// Akinci-style cohesion (surface tension lite): attracts within h/2,
		// mildly repels beyond, so free particles bead up without clumping.
		// Oil and water are immiscible: cohesion holds each phase together but
		// not one to the other (weighted by how alike the pair's oil fractions are).
		float like = params.material == MATERIAL_OIL ? 1.0 - abs(phase - positions.data[j].w) : 1.0;
		if (cohesion > 0.0) {
			surface_force += dir * sph_cohesion_k(dst) / dj * cohesion * like;
		}
		if (params.material == MATERIAL_HONEY) {
			float separation = max(dot(velocities_snap.data[j].xyz - vel_i, dir), 0.0);
			// The pair's mean density over rest stands in for "how many neighbours
			// share the pull": the same for both partners, so their pulls are
			// equal and opposite, and as strong in a thin rope as the old
			// per-particle neighbour count made it.
			float crowding = max(0.5 * (density + dj) / params.sim.y, 0.05);
			extension += dir * separation * smoothstep(0.2, 0.65, dst / params.kernel.x)
				* (1.0 - smoothstep(0.8, 1.0, dst / params.kernel.x)) / crowding;
		}
		if (params.material == MATERIAL_SPECTRAL_GEL) {
			vec4 other = gel_reference.data[uint(round(velocities_snap.data[j].w))];
			float rest_length = length(other.xyz - reference.xyz);
			if (other.w == reference.w && dst > 1e-6 && rest_length > 1e-6 && rest_length < params.kernel.x) {
				float fade = (1.0 - rest_length / params.kernel.x) * (1.0 - dst / params.kernel.x);
				elastic_force += dir * (dst - rest_length) * fade / 16.0;
			}
		}

		if (spawn_foam) {
			vec3 rel_v = vel_i - velocities_snap.data[j].xyz;
			float rel_mag = length(rel_v);
			vec3 rel_dir = rel_v / max(rel_mag, 1e-6);
			// 0 when moving apart, up to 2 when moving straight at each other.
			float converge = 1.0 - dot(rel_dir, -dir);
			float influence = 1.0 - min(1.0, dst / params.kernel.x);
			trapped_air += rel_mag * converge * influence;
		}
	)
	// SebLague's double-density force: both pressure terms (and cohesion) are
	// divided by the particle's own density. The solver folds the rest-lattice
	// ratio into the near stiffness, so a particle at rest feels what it did
	// when the near term divided by the near density.
	// Two-phase oil by density contrast (Solenthaler & Pajarola 2008): particles
	// share one volume (one spacing) and w holds the particle's oil volume
	// fraction, so its mass is the mixture's, between 850/1000 and 1 of a water
	// particle's. Pressure and cohesion are volume forces; dividing by the
	// particle's own mass makes the lighter phase rise under the same pressure
	// gradient -- buoyancy emerges, momentum-conserving, instead of being added
	// (the drift in sph_viscosity carries it below the particle scale).
	float mass = params.material == MATERIAL_OIL
		? mix(1.0, scene.fluid_material.x / OIL_WATER_DENSITY, phase) : 1.0;
	vec3 accel = (force + near_force + surface_force) / (max(density, 1e-6) * mass);
	if (params.material == MATERIAL_HONEY) {
		// Each pair term was divided by a symmetric crowding factor above, so
		// only the constant rest neighbour count is left: momentum is conserved,
		// which dividing by this particle's own neighbour count broke at every
		// surface.
		accel += extension * params.sim2.w / max(scene.fluid_rheology.y, 1.0);
	}
	if (params.material == MATERIAL_SPECTRAL_GEL) {
		accel += elastic_force * params.sim2.w;
	}
	vec3 v = vel_i + accel * params.sim.x;
	// Airborne particles (few neighbors) get drag so spray doesn't fling away.
	if (neighbours < 8) {
		v -= v * params.sim.x * (params.material == MATERIAL_MERCURY ? 0.75 * 1000.0 / scene.fluid_material.x : 0.75);
	}
	velocities.data[i] = vec4(v, velocities.data[i].w);

	// --- Spawn white particles from this fluid particle ---
	// Water only: in lava the white-particle look makes no sense.
	if (!spawn_foam) {
		return;
	}
	// Surface gate: interior particles (density near rest) have full kernel
	// support, so their trapped-air metric comes from wall shear or bulk churn
	// rather than the free surface — foam born there sticks to the walls. The
	// gate fades spawning out as density approaches the rest value.
	float air_factor = foam.spawn.x * remap01(trapped_air, foam.spawn.y, foam.spawn.z);
	if (foam.render.z > 0.0) {
		air_factor *= remap01(params.sim.y * foam.render.z - density, 0.0, params.sim.y * 0.1);
	}
	float ke_factor = remap01(dot(vel_i, vel_i), foam.spawn.w, foam.spawn2.x);
	float spawn_factor = air_factor * ke_factor * params.sim.x;
	if (nitrogen) {
		// Boiling: the heat picked up touching a warm surface (phase) boils off,
		// and the free surface steams a little on its own.
		float exposed = remap01(params.sim.y * 0.9 - density, 0.0, params.sim.y * 0.2);
		spawn_factor = foam.spawn.x * (phase + NITROGEN_SURFACE_BOIL * exposed) * params.sim.x;
	}
	// Fresh emitter layers are packed into the ones ahead of them: that
	// convergence is the nozzle's, not air entrained by the flow.
	if (scene.emitter_velocity.w > 0.5 && distance(pos, scene.emitter_origin.xyz) < NOZZLE_FOAM_CLEARANCE) {
		return;
	}
	if (spawn_factor <= 0.0) {
		return;
	}
	uint rng = pcg_hash(i * 747796405u + uint(params.misc.w) * 2246822519u);
	// Fractional part is the probability of one extra particle.
	int spawn_count = int(floor(spawn_factor));
	if (rand01(rng) < spawn_factor - float(spawn_count)) {
		spawn_count++;
	}
	// Vapour rises off still liquid, so its spawn cylinder stands upright.
	vec3 axis = nitrogen ? vec3(0.0, 1.0, 0.0) : v;
	// A zero-length axis would produce NaN spawn positions.
	if (spawn_count <= 0 || dot(axis, axis) < 1e-6) {
		return;
	}
	// Reserve a contiguous run at the end of the live pool. The counter takes the
	// full request even when the pool is full, so it can read past the cap until
	// foam_compact resets it -- every consumer clamps with foam_live().
	uint cap = uint(foam.cls.z);
	uint base = atomicAdd(foam_count.data[0], uint(spawn_count));
	if (base + 1u >= cap) {
		return;
	}
	spawn_count = min(spawn_count, int(cap - base - 1u));
	// Spawn inside a cylinder whose axis is the particle's motion this sub-step.
	vec3 axis_a = orthonormal(axis);
	vec3 axis_b = normalize(cross(axis_a, axis));
	float radius = params.kernel.x * foam.render.y;
	for (int k = 0; k < spawn_count; k++) {
		uint slot = base + uint(k);
		float ang = rand01(rng) * 6.28318530718;
		vec3 odir = cos(ang) * axis_a + sin(ang) * axis_b;
		vec3 base_off = sqrt(rand01(rng)) * radius * odir;
		vec3 spawn_pos = pos + base_off + v * params.sim.x * rand01(rng);
		float life = mix(foam.spawn2.y, foam.spawn2.z, rand01(rng));
		foam_pos.data[slot] = vec4(spawn_pos, life);
		// Spawn small (and varied) and let the update pass grow the scale in:
		// a full-size sprite popping into existence reads as a blink. Staggered
		// lifetimes then keep the sheet's sizes spread as it dissolves.
		float variance = mix(0.75, 1.25, rand01(rng));
		vec3 spawn_v = nitrogen ? v + base_off * 4.0 + vec3(0.0, NITROGEN_PUFF_SPEED, 0.0) : v + base_off;
		foam_vel.data[slot] = vec4(spawn_v, (foam.motion.z + 1.0) * 0.5 * variance * 0.3);
	}
}
