layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    float shift = float(-2 * ((id.x & 1) ^ (id.y & 1)) + 1);
    vec2 horizontal = fft_data[FFT_IDX(id.x, id.y, 0, 1)] * shift;
    vec2 vertical = fft_data[FFT_IDX(id.x, id.y, 1, 1)] * shift;
    imageStore(velocity_map, ivec3(id, params.misc.x),
        vec4(horizontal.x, vertical.x, horizontal.y, 0.0));
}
