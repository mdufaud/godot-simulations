layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

ivec2 wrap_id(ivec2 id) {
    return (id + ivec2(MAP_SIZE_I)) % ivec2(MAP_SIZE_I);
}

vec2 foam_at(ivec2 id, int cascade) {
    return imageLoad(foam_input, ivec3(wrap_id(id), cascade)).rg;
}

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    int cascade = params.misc.x;
    vec2 history = foam_at(id, cascade);

    vec4 breaking = imageLoad(normal_map, ivec3(id, cascade));
    float injection = breaking.a;
    float crest = breaking.b;
    float breaking_support = injection;
    for (int radius = 1; radius <= 2; radius++) {
        breaking_support = max(breaking_support,
            imageLoad(normal_map, ivec3(wrap_id(id + ivec2(radius, 0)), cascade)).a);
        breaking_support = max(breaking_support,
            imageLoad(normal_map, ivec3(wrap_id(id + ivec2(-radius, 0)), cascade)).a);
        breaking_support = max(breaking_support,
            imageLoad(normal_map, ivec3(wrap_id(id + ivec2(0, radius)), cascade)).a);
        breaking_support = max(breaking_support,
            imageLoad(normal_map, ivec3(wrap_id(id + ivec2(0, -radius)), cascade)).a);
    }
    float cascade_bias = cascade == 0 ? 1.5 : 1.0;
    float persistent_injection = pow(smoothstep(
        0.055 * cascade_bias, 0.50 * cascade_bias, injection), 1.15);
    float fresh_injection = pow(clamp(injection * 3.5 / cascade_bias, 0.0, 1.0), 1.6);
    float persistent = history.r * exp(-params.foam_p.z);
    float fresh = history.g * exp(-params.foam_p.z * 6.0)
        * smoothstep(0.0, 0.16, breaking_support);
    float persistent_growth = params.foam_p.y * (0.012 + crest * 0.018);
    float fresh_growth = params.foam_p.y * (0.35 + crest * 0.30);
    persistent = clamp(persistent + persistent_injection * persistent_growth
        * (1.0 - persistent), 0.0, 1.0);
    fresh = clamp(fresh + fresh_injection * fresh_growth * (1.0 - fresh), 0.0, 1.0);
    imageStore(foam_output, ivec3(id, cascade), vec4(persistent, fresh, 0.0, 1.0));
}
