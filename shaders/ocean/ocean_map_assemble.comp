// Unpacks IFFT outputs into displacement and normal maps. The (-1)^(x+y)
// factor is an ifftshift; the second un-transpose is a 90° rotation invisible
// to the wave field. Normal-map alpha stores this frame's Jacobian breaking
// source; persistent foam is handled by ocean_foam_feedback.comp.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 7) uniform sampler2D foam_noise_texture;

float shifted_component(ivec2 id, int layer, int component) {
    ivec2 wrapped = (id + ivec2(MAP_SIZE_I)) % ivec2(MAP_SIZE_I);
    float sign_shift = float(-2 * ((wrapped.x & 1) ^ (wrapped.y & 1)) + 1);
    vec2 value = fft_data[FFT_IDX(wrapped.x, wrapped.y, layer, 1)] * sign_shift;
    return component == 0 ? value.x : value.y;
}

float height_sample(ivec2 id, int cascade) {
    return shifted_component(id, cascade, 1);
}

// The tutorial field is periodic over a fixed 20 m domain regardless of the
// short cascade's tile length: wave vectors are integer cycles of that domain
// and the noise repeats an integer number of times per domain.
const float TUTORIAL_DOMAIN = 20.0;

float tutorial_noise(vec2 uv, vec2 direction) {
    float repeats = params.spectrum_a.x / TUTORIAL_DOMAIN * 2.0;
    float loop_time = mod(params.foam_p.w, 200.0);
    return textureLod(foam_noise_texture,
        uv * repeats * 2.0 + vec2(1.0) + loop_time * direction * 0.07, 0.0).r;
}

vec3 tutorial_gerstner(vec2 pos, vec2 uv, vec2 direction, float amplitude,
        float frequency, float speed, float steepness, float scale) {
    direction = normalize(direction);
    vec2 wave_vector = direction
        * round(frequency * TUTORIAL_DOMAIN / (2.0 * PI))
        * (2.0 * PI / TUTORIAL_DOMAIN);
    float angular_speed = round(speed * 200.0 / (2.0 * PI))
        * (2.0 * PI / 200.0);
    float phase = mod(params.foam_p.w, 200.0) * angular_speed
        + dot(wave_vector, pos);
    float noise_value = tutorial_noise(uv, direction) - 0.5;
    vec3 displacement;
    displacement.y = sin(phase) * amplitude + noise_value * 0.05;
    displacement.xz = direction * cos(phase) * steepness
        + noise_value * vec2(0.06, -0.06);
    return displacement * scale;
}

vec3 tutorial_displacement(ivec2 id) {
    ivec2 wrapped = (id + ivec2(MAP_SIZE_I)) % ivec2(MAP_SIZE_I);
    vec2 uv = (vec2(wrapped) + 0.5) / float(MAP_SIZE);
    vec2 pos = uv * params.spectrum_a.x;
    float scale = clamp(params.gains.w / 1.7, 0.0, 1.5);
    vec3 displacement = tutorial_gerstner(pos, uv, vec2(0.0, 1.0),
        0.4, 1.0, 1.3, 0.2, scale);
    displacement += tutorial_gerstner(pos, uv, vec2(1.0, 1.0),
        0.15, 1.3, 1.6, 0.12, scale);
    displacement += tutorial_gerstner(pos, uv, vec2(1.0, 0.0),
        0.12, 2.0, 2.0, 0.17, scale);
    displacement += tutorial_gerstner(pos, uv, vec2(-0.4, 1.0),
        0.01, 3.0, 3.0, 0.1, scale);
    displacement += tutorial_gerstner(pos, uv, vec2(-0.2, 0.7),
        0.025, 4.0, 4.0, 0.08, scale);
    return displacement;
}

float stylized_crest_strength() {
    // Art-directed spectrum flavour (bit 1 clear); JONSWAP stays unshaped.
    return (params.misc.w & 2) == 0
        ? clamp((params.art_a.w - 1.0) * 0.14, 0.0, 0.30)
        : 0.0;
}

float crest_profile_term(float normalized) {
    float positive = max(normalized, 0.0);
    float negative = max(-normalized, 0.0);
    float positive_term = positive * positive / (1.0 + positive * positive);
    float negative_term = negative * negative / (1.0 + negative * negative);
    return positive_term * 1.20 + negative_term;
}

float stylized_height(float height, float reference_height, float strength) {
    float normalized = height / max(reference_height, 1e-4);
    return height + reference_height * strength * crest_profile_term(normalized);
}

float stylized_height_derivative(float height, float reference_height, float strength) {
    float normalized = height / max(reference_height, 1e-4);
    if (normalized <= 0.0) {
        float negative = -normalized;
        float denom = 1.0 + negative * negative;
        return 1.0 - strength * 2.0 * negative / (denom * denom);
    }
    float denom = 1.0 + normalized * normalized;
    return 1.0 + strength * 1.20 * 2.0 * normalized / (denom * denom);
}

float shaped_height_sample(ivec2 id, int cascade, float reference_height, float strength) {
    return stylized_height(height_sample(id, cascade), reference_height, strength);
}

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    int cascade = params.misc.x;
    bool tutorial_model = (params.misc.w & 1) == 1;
    bool pure_tutorial = tutorial_model
        && params.gains.y <= 0.001 && params.art_b.y <= 0.001;
    if (pure_tutorial && cascade < 2) {
        imageStore(displacement_map, ivec3(id, cascade), vec4(0.0));
        imageStore(normal_map, ivec3(id, cascade), vec4(0.0));
        return;
    }
    if (tutorial_model && cascade == 2) {
        float texel_m = params.spectrum_a.x / float(MAP_SIZE);
        vec3 wave_current = tutorial_displacement(id);
        vec3 wave_right = tutorial_displacement(id + ivec2(1, 0));
        vec3 wave_back = tutorial_displacement(id + ivec2(0, 1));
        vec3 dpos_x = wave_right - wave_current;
        vec3 dpos_z = wave_back - wave_current;
        float dhx_dx = dpos_x.x / texel_m;
        float dhx_dz = dpos_z.x / texel_m;
        float dhz_dx = dpos_x.z / texel_m;
        float dhz_dz = dpos_z.z / texel_m;
        float dhy_dx = dpos_x.y / texel_m;
        float dhy_dz = dpos_z.y / texel_m;
        float jacobian = (1.0 + dhx_dx) * (1.0 + dhz_dz)
            - dhx_dz * dhz_dx;
        float safe_jacobian = (jacobian < 0.0 ? -1.0 : 1.0)
            * max(abs(jacobian), 0.08);
        vec2 gradient = vec2(
            ((1.0 + dhz_dz) * dhy_dx - dhz_dx * dhy_dz) / safe_jacobian,
            ((1.0 + dhx_dx) * dhy_dz - dhx_dz * dhy_dx) / safe_jacobian
        );
        float scale = clamp(params.gains.w / 1.7, 0.0, 1.5);
        float crest = smoothstep(0.12 * scale, 0.52 * scale, wave_current.y);
        float compression = 1.0 - smoothstep(0.0, 0.7, jacobian);
        imageStore(displacement_map, ivec3(id, cascade), vec4(wave_current, 0.0));
        imageStore(normal_map, ivec3(id, cascade), vec4(
            clamp(gradient, vec2(-4.0), vec2(4.0)), crest, compression));
        return;
    }
    float chop = params.spectrum_c.w;
    float sign_shift = float(-2 * ((id.x & 1) ^ (id.y & 1)) + 1);

    vec2 l0 = fft_data[FFT_IDX(id.x, id.y, 0, 1)] * sign_shift;
    vec2 l1 = fft_data[FFT_IDX(id.x, id.y, 1, 1)] * sign_shift;
    vec2 l2 = fft_data[FFT_IDX(id.x, id.y, 2, 1)] * sign_shift;
    vec2 l3 = fft_data[FFT_IDX(id.x, id.y, 3, 1)] * sign_shift;

    // Master height gain is applied k-weighted in spectrum_init (long swell
    // only), so heights, derivatives, choppy fields and Jacobian foam all
    // stay mutually consistent here with no extra scaling.
    float hx = l0.x * chop;
    float raw_hy = l0.y;
    float hz = l1.x * chop;
    float dhx_dx = l2.y * chop;
    float dhz_dz = l3.x * chop;
    float dhz_dx = l3.y * chop;
    float dhx_dz = dhz_dx;

    float jacobian = (1.0 + dhx_dx) * (1.0 + dhz_dz) - dhx_dz * dhz_dx;
    float band_height = params.misc.x == 0 ? params.gains.y
        : (params.misc.x == 1 ? params.art_b.y : params.gains.w);
    float band_length = params.misc.x == 0 ? params.gains.z
        : (params.misc.x == 1 ? params.art_b.z : params.art_a.x);
    float height_reference = max(0.35, band_height * 0.72
        + params.gains.w * 0.08);
    // Cascade 2 only carries the short tail of the wind sea, but band_height
    // refers to the full wind wave height — its raw heights sit ~4x below the
    // crest window and the crest mask starves (Storm crest p99 = 0.04).
    // Scale the reference to the band's own amplitude (Storm p99|hy| = 0.35).
    if (cascade == 2) {
        height_reference = max(0.35, height_reference * 0.28);
    }
    float crest_strength = stylized_crest_strength();
    // Keep displacement physically generated by the FFT. Crest gain shapes the
    // breaking mask below, not the vertical surface itself; sculpting height
    // here produced needle-like storm peaks and broke the Jacobian contract.
    float hy = raw_hy;
    float height_derivative = 1.0;
    float dhy_dx = l1.y * height_derivative;
    float dhy_dz = l2.x * height_derivative;
    float height_norm = hy / height_reference;
    float texel_m = params.spectrum_a.x / float(MAP_SIZE);
    float laplacian = (4.0 * hy
        - height_sample(id + ivec2(1, 0), cascade)
        - height_sample(id + ivec2(-1, 0), cascade)
        - height_sample(id + ivec2(0, 1), cascade)
        - height_sample(id + ivec2(0, -1), cascade))
        / max(texel_m * texel_m, 1e-4);
    float curvature_scale = height_reference
        * pow(2.0 * PI / max(band_length, 2.0), 2.0);
    float crest_curvature = max(0.0, laplacian)
        / max(curvature_scale, 1e-4);
    float slope = length(vec2(dhy_dx, dhy_dz));
    float crest_height = smoothstep(0.16 - crest_strength * 0.10, 0.66, height_norm);
    // P0-B (cause C5): widen the emission window — more crests above the
    // compression threshold at the same instant. The crest mask loosens from
    // (0.62, 1.42) to (0.45, 1.20) and the calm guard lives in the threshold
    // formula, which the zero-foam test keeps absolute.
    float crest_shape = smoothstep(0.45, 1.20, crest_curvature);
    float crest_slope = smoothstep(0.035, 0.22 + params.art_b.x * 0.10, slope);
    float crest = pow(crest_height * crest_shape
        * mix(0.42, 1.0, crest_slope), 1.35);
    float breaking_source = 1.0 - smoothstep(0.0, 0.7, jacobian);
    if (!tutorial_model) {
        // Production path: continuous compression mask with per-cascade
        // threshold and gain. The long cascade only folds at genuine breaker
        // events; the short one needs a raised threshold so constant
        // micro-folding does not flood the mask.
        float compression = max(0.0, 1.0 - jacobian);
        float sea_state_level = clamp(params.spectrum_a.w / 33.0
            + params.spectrum_b.z * 0.22, 0.0, 1.0);
        float threshold_bias = cascade == 0 ? 1.5 : (cascade == 2 ? 1.25 : 1.0);
        float compression_threshold = max(0.020,
            0.19 + (1.0 - params.foam_p.x) * 0.10 - sea_state_level * 0.045)
            * 0.5 * threshold_bias;
        float compression_span = mix(0.10, 0.075, sea_state_level);
        float medium_breaking_gain = params.misc.x == 1
            ? mix(0.5, 1.0, smoothstep(0.85, 2.0, band_height)) : 1.0;
        float cascade_gain = params.misc.x == 1 ? medium_breaking_gain : 1.0;
        breaking_source = smoothstep(compression_threshold,
            compression_threshold + compression_span, compression)
            * mix(0.50, 1.0, crest) * cascade_gain;
    }

    float safe_jacobian = (jacobian < 0.0 ? -1.0 : 1.0) * max(abs(jacobian), 0.08);
    vec2 gradient = vec2(
        ((1.0 + dhz_dz) * dhy_dx - dhz_dx * dhy_dz) / safe_jacobian,
        ((1.0 + dhx_dx) * dhy_dz - dhx_dz * dhy_dx) / safe_jacobian
    );
    gradient = clamp(gradient, vec2(-4.0), vec2(4.0));

    imageStore(displacement_map, ivec3(id, cascade), vec4(hx, hy, hz, 0.0));
    imageStore(normal_map, ivec3(id, cascade),
        vec4(gradient, crest, clamp(breaking_source, 0.0, 1.0)));
}
