layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

vec2 dispersion_and_derivative(float k, float depth) {
    float a = k * depth;
    float b = tanh(a);
    float w = sqrt(G_GRAV * k * b);
    float dw_dk = 0.5 * G_GRAV * (b + a * (1.0 - b * b)) / w;
    return vec2(w, dw_dk);
}

float longuet_higgins_normalization(float s) {
    float a = sqrt(s);
    return (s < 0.4)
        ? (0.5 / PI) + s * (0.220636 + s * (-0.109 + s * 0.090))
        : inversesqrt(PI) * (a * 0.5 + (1.0 / a) * 0.0625);
}

float longuet_higgins_function(float s, float theta) {
    return longuet_higgins_normalization(s) * pow(abs(cos(theta * 0.5)), 2.0 * s);
}

float hasselmann_directional_spread(float w, float w_p, float wind_speed,
        float swell_weight, float theta) {
    float p = w / w_p;
    float s = (w <= w_p)
        ? 6.97 * pow(abs(p), 4.06)
        : 9.77 * pow(abs(p), -2.33 - 1.45 * (wind_speed * w_p / G_GRAV - 1.17));
    float s_xi = 16.0 * tanh(w_p / w) * swell_weight * swell_weight;
    return longuet_higgins_function(s + s_xi, theta);
}

float tma_spectrum(float w, float w_p, float alpha, float depth) {
    const float beta = 1.25;
    const float gamma = 3.3;
    float sigma = (w <= w_p) ? 0.07 : 0.09;
    float r = exp(-(w - w_p) * (w - w_p)
        / (2.0 * sigma * sigma * w_p * w_p));
    float jonswap = (alpha * G_GRAV * G_GRAV) / pow(w, 5.0)
        * exp(-beta * pow(w_p / w, 4.0)) * pow(gamma, r);
    float w_h = min(w * sqrt(depth / G_GRAV), 2.0);
    float depth_attenuation = (w_h <= 1.0)
        ? 0.5 * w_h * w_h
        : 1.0 - 0.5 * (2.0 - w_h) * (2.0 - w_h);
    return jonswap * depth_attenuation;
}

float broad_log_band(float k, float wavelength, float width) {
    float center = 2.0 * PI / max(wavelength, 0.05);
    float distance = log(max(k / center, 1e-6)) / width;
    return exp(-0.5 * distance * distance);
}

vec2 rotate_direction(vec2 direction, float angle) {
    float c = cos(angle);
    float s = sin(angle);
    return vec2(c * direction.x - s * direction.y,
        s * direction.x + c * direction.y);
}

float broad_direction(vec2 k_dir, vec2 wind_dir, float spread_value,
        float crosswind) {
    float spread_amount = clamp(spread_value, 0.0, 1.0);
    float lobe_angle = mix(0.20, 0.52,
        clamp(spread_amount + crosswind * 0.35, 0.0, 1.0));
    vec2 left_dir = rotate_direction(wind_dir, -lobe_angle);
    vec2 right_dir = rotate_direction(wind_dir, lobe_angle);
    float focus = mix(5.0, 18.0, 1.0 - spread_amount);
    float primary = longuet_higgins_function(focus,
        acos(clamp(dot(k_dir, wind_dir), -1.0, 1.0)));
    float left = longuet_higgins_function(focus,
        acos(clamp(dot(k_dir, left_dir), -1.0, 1.0)));
    float right = longuet_higgins_function(focus,
        acos(clamp(dot(k_dir, right_dir), -1.0, 1.0)));
    // P1-B (loi L6): a stronger side lobe breaks parallel ribbons into wave
    // groups and festoons instead of a single wind train.
    float secondary_weight = clamp(crosswind * 0.38, 0.0, 0.30);
    float side = 0.5 * (left + right);
    return mix(primary, side, secondary_weight) * (1.0 - secondary_weight)
        + 0.5 / PI * secondary_weight;
}

vec2 spectrum_amplitude(ivec2 id) {
    float dk = 2.0 * PI / params.spectrum_a.x;
    vec2 k_vec = (vec2(id) - float(MAP_SIZE) * 0.5) * dk;
    float k = length(k_vec) + 1e-6;
    if (k < params.spectrum_c.y || k >= params.spectrum_c.z) {
        return vec2(0.0);
    }

    vec2 k_dir = k_vec / k;
    vec2 wind_dir = vec2(sin(params.spectrum_b.x), cos(params.spectrum_b.x));
    vec2 disp = dispersion_and_derivative(k, params.spectrum_b.y);
    float w = disp.x;
    float w_norm = disp.y / k * dk * dk;
    float long_level = clamp(params.gains.y / 5.0, 0.0, 1.0);
    float long_peak = sqrt(G_GRAV * 2.0 * PI
        / max(params.gains.z, 20.0));
    float peak_frequency = mix(params.spectrum_a.z, long_peak,
        clamp(0.45 + long_level * 0.35, 0.0, 0.8));
    float base = tma_spectrum(w, peak_frequency, params.spectrum_a.y,
        params.spectrum_b.y);

    float spread_value = clamp(params.spectrum_c.x, 0.0, 1.0);
    float directional = mix(0.5 / PI,
        hasselmann_directional_spread(w, peak_frequency, params.spectrum_a.w,
            params.spectrum_b.z, atan(k_vec.x, k_vec.y) - params.spectrum_b.x),
        1.0 - spread_value);

    float mid_level = clamp(params.art_b.y / 2.0, 0.0, 1.0);
    float wind_level = clamp(params.gains.w / 1.5, 0.0, 1.0);
    float ripple_level = clamp(params.art_a.y / 1.5, 0.0, 1.0);
    float long_band = broad_log_band(k, params.gains.z, 0.48);
    float mid_band = broad_log_band(k, params.art_b.z, 0.56);
    float wind_band = broad_log_band(k, params.art_a.x, 0.66);
    // P1-B (cause C2): widen the ripple band so it fills the bottom of
    // cascade 2's k range (the old 0.84/0.88 band already fell to 0.39 at
    // kmin = 2.218 rad/m).
    float ripple_band = broad_log_band(k, 0.9, 1.05);
    float wind_sea_level = clamp(params.spectrum_a.w / 33.0, 0.0, 1.0);
    float sea_state_level = clamp(wind_sea_level + params.spectrum_b.z * 0.22,
        0.0, 1.0);
    float long_steepness = 2.0 * PI * params.gains.y
        / max(params.gains.z, 20.0);
    float long_energy = clamp((long_steepness / 0.12)
        * (long_steepness / 0.12), 0.5, 10.0);
    float mid_steepness = 2.0 * PI * params.art_b.y
        / max(params.art_b.z, 5.0);
    float mid_energy = clamp((mid_steepness / 0.12)
        * (mid_steepness / 0.12), 0.5, 8.0);
    float art_weight = 0.08
        + long_band * (0.45 + long_level * 1.15 + (long_energy - 1.0) * 0.30)
        + mid_band * (0.24 + mid_level * 1.35 + (mid_energy - 1.0) * 0.34)
        + wind_band * (0.26 + wind_level * (0.80 + sea_state_level * 0.70))
        + ripple_band * (0.22 + ripple_level * 0.55);

    float crosswind_band = clamp(mid_band * 0.85 + wind_band * 0.65
        + ripple_band * 0.25, 0.0, 1.0);
    float art_direction = broad_direction(k_dir, wind_dir,
        max(spread_value, params.art_b.w), params.art_a.z * crosswind_band);
    directional = mix(directional, art_direction,
        clamp(0.62 + long_level * 0.18 + mid_level * 0.08, 0.62, 0.88));

    // Let the intermediate field carry a slightly wider, independent lobe.
    // It bends the flank modulation without injecting a second broad
    // crosswind hill. The weight is bounded so total energy remains governed
    // by art_weight and the height calibration below.
    float mid_direction = broad_direction(k_dir, wind_dir,
        max(spread_value, params.art_b.w),
        params.art_a.z * (0.75 + 0.25 * mid_band));
    float mid_direction_weight = clamp(mid_band
        * (0.16 + mid_level * 0.22), 0.0, 0.30);
    float wind_direction_weight = clamp(wind_band
        * (0.08 + wind_level * 0.10), 0.0, 0.14);
    directional = mix(directional, mid_direction,
        clamp(mid_direction_weight + wind_direction_weight, 0.0, 0.45));

    // Storm recipe: 65% dominant wind lobe, 25% cross lobe at +35°, 10%
    // diffuse. Interference between the lobes is what produces grouped big
    // waves, lulls and isolated crests instead of parallel ribbons. The long
    // cascade rotates its dominant lobe -15° off the wind so swell and wind
    // sea never align perfectly.
    float storm_mix = smoothstep(20.0, 28.0, params.spectrum_a.w);
    if (storm_mix > 0.001) {
        float swell_offset = radians(-15.0) * storm_mix
            * clamp(long_level * 1.5, 0.0, 1.0);
        vec2 main_dir = rotate_direction(wind_dir,
            params.misc.x == 0 ? swell_offset : 0.0);
        vec2 cross_dir = rotate_direction(wind_dir, radians(35.0));
        float main_lobe = longuet_higgins_function(8.0,
            acos(clamp(dot(k_dir, main_dir), -1.0, 1.0)));
        float cross_lobe = longuet_higgins_function(11.0,
            acos(clamp(dot(k_dir, cross_dir), -1.0, 1.0)));
        float storm_directional = 0.65 * main_lobe + 0.25 * cross_lobe
            + 0.10 * (0.5 / PI);
        directional = mix(directional, storm_directional, storm_mix);
    }

    directional *= exp(-(1.0 - params.spectrum_b.w)
        * (1.0 - params.spectrum_b.w) * k * k);

    vec2 u = hash2(uvec2(id + ivec2(params.misc.y, params.misc.z)));
    float gain = 1.0 + (params.gains.x - 1.0) * exp(-k * 9.549);
    // The explicit long/mid/wind controls redistribute energy. This small
    // low-sea-state compensation keeps that redistribution within the
    // established height envelope instead of making Calm visibly collapse.
    float energy_scale = 1.13
        + 0.55 * exp(-params.gains.y / 0.5)
        + 0.16 * exp(-params.spectrum_a.w / 6.0);
    float art_gain = sqrt(max(0.08, art_weight))
        * (1.0 + long_level * 0.18 + mid_level * 0.08) * energy_scale;
    return gaussian_pair(u) * sqrt(2.0 * base * directional * w_norm)
        * 0.25 * art_gain * gain;
}

void main() {
    ivec2 id0 = ivec2(gl_GlobalInvocationID.xy);
    ivec2 id1 = (ivec2(MAP_SIZE_I) - id0) % ivec2(MAP_SIZE_I);
    imageStore(spectrum_tex, ivec3(id0, params.misc.x),
        vec4(spectrum_amplitude(id0), conj_complex(spectrum_amplitude(id1))));
}
