layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    float shift = float(-2 * ((id.x & 1) ^ (id.y & 1)) + 1);
    vec2 height_x = fft_data[FFT_IDX(id.x, id.y, 0, 1)] * shift;
    vec2 velocity_z = fft_data[FFT_IDX(id.x, id.y, 1, 1)] * shift;
    vec2 velocity_rate = fft_data[FFT_IDX(id.x, id.y, 2, 1)] * shift;
    imageStore(boundary_map, ivec3(id, params.misc.y), vec4(height_x, velocity_z.x, 0.0));
    imageStore(boundary_map, ivec3(id, params.misc.y + 3), vec4(velocity_z.y, velocity_rate, 0.0));
}
