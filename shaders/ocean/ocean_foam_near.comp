layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2DArray derivative_fields;
layout(set = 0, binding = 1) uniform sampler2DArray history_input;
layout(rg32f, set = 0, binding = 2) restrict uniform image2D near_output;

layout(push_constant, std430) uniform NearParams {
    vec4 camera;
    vec4 rates;
    vec4 cfg;
    ivec4 icfg;
    vec4 tiles;
    vec4 extra;
} np;

float integrate_coverage(float previous, float growth, float decay) {
    float rate = growth + decay;
    float equilibrium = growth / max(rate, 1e-8);
    return mix(previous, equilibrium, 1.0 - exp(-rate));
}

float breaking_at(vec2 position) {
    vec3 derivative = vec3(0.0);
    for (int cascade = 0; cascade < 3; cascade++) {
        if ((np.icfg.y & (1 << cascade)) != 0) {
            derivative += textureLod(derivative_fields,
                vec3(position / np.tiles[cascade], float(cascade)), 0.0).xyz;
        }
    }
    float a = 1.0 + derivative.x;
    float b = 1.0 + derivative.y;
    float c = derivative.z;
    float stretch = 0.5 * (a + b - sqrt((a - b) * (a - b) + 4.0 * c * c));
    return smoothstep(0.0, 0.2, np.tiles.w - stretch);
}

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv = (vec2(id) + 0.5) / np.cfg.w;
    vec2 world = np.camera.xy + (uv - 0.5) * np.cfg.x;
    vec2 previous_uv = (world - np.camera.zw
        - np.extra.zw * np.cfg.z * np.cfg.y) / np.cfg.x + 0.5;
    vec2 previous = vec2(0.0);
    vec2 border = min(previous_uv, 1.0 - previous_uv) * np.cfg.w;
    if (min(border.x, border.y) >= 0.5) {
        previous = textureLod(history_input, vec3(previous_uv, float(np.icfg.x)), 0.0).rg;
    }
    float footprint = np.cfg.x / np.cfg.w * 0.25;
    float source = 0.25 * (breaking_at(world + vec2(footprint, footprint))
        + breaking_at(world + vec2(-footprint, footprint))
        + breaking_at(world + vec2(footprint, -footprint))
        + breaking_at(world - vec2(footprint, footprint)));
    float fresh = integrate_coverage(previous.g, source * np.rates.w, np.rates.y);
    float active_rate = source * np.rates.w + np.rates.y;
    float active_equilibrium = source * np.rates.w / max(active_rate, 1e-8);
    float residual_decay = exp(-np.rates.x);
    float rate_difference = active_rate - np.rates.x;
    float transfer = abs(rate_difference) < 1e-5
        ? residual_decay * (1.0 - 0.5 * rate_difference)
        : (residual_decay - exp(-active_rate)) / rate_difference;
    float persistent = previous.r * residual_decay
        + np.rates.z / max(np.rates.x, 1e-8) * active_equilibrium * (1.0 - residual_decay)
        + np.rates.z * (previous.g - active_equilibrium) * transfer;
    imageStore(near_output, id, vec4(persistent, fresh, 0.0, 1.0));
}
