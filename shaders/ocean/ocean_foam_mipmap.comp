layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(rg32f, set = 0, binding = 0) readonly uniform image2D source_level;
layout(rg32f, set = 0, binding = 1) writeonly uniform image2D target_level;
layout(push_constant, std430) uniform MipParams { ivec4 dimensions; } params;

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(id, ivec2(params.dimensions.x)))) return;
    ivec2 p = id * 2;
    vec4 mean = (imageLoad(source_level, p) + imageLoad(source_level, p + ivec2(1, 0))
        + imageLoad(source_level, p + ivec2(0, 1)) + imageLoad(source_level, p + ivec2(1, 1))) * 0.25;
    imageStore(target_level, id, mean);
}
