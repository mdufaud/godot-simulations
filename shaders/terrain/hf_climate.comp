// Climate pass, pointwise on the source texture: snow melts into water, water
// evaporates away, standing water freezes back into snow, fresh snowfall
// accumulates above the snowline, and sediment stranded by dried-out water settles
// onto the sand. Everything happens inside one cell: total mass is conserved
// except evaporation, rain, snowfall and uplift.

layout(set = 0, binding = 5, std430) readonly buffer SummitSources {
	vec4 source[];
} springs;

float uplift_noise(ivec2 p) {
	uint h = uint(p.x) * 374761393u + uint(p.y) * 668265263u + 7u * 2246822519u;
	h = (h ^ (h >> 13u)) * 1274126177u;
	return float((h ^ (h >> 16u)) & 0xFFFFFFu) / float(0xFFFFFFu);
}

float uplift_profile(ivec2 id, int n) {
	int mode = int(weather.hydro.w);
	vec2 p = (vec2(id) + 0.5) / float(n) - 0.5;
	if (mode == 1) {
		float radius = params.misc2.w;
		return exp(-3.0 * dot(p, p) / (radius * radius));
	}
	if (mode == 2) {
		vec2 q = (p + 0.5) * 6.0;
		ivec2 cell = ivec2(floor(q));
		vec2 t = fract(q);
		t = t * t * (3.0 - 2.0 * t);
		return mix(mix(uplift_noise(cell), uplift_noise(cell + ivec2(1, 0)), t.x),
			mix(uplift_noise(cell + ivec2(0, 1)), uplift_noise(cell + ivec2(1, 1)), t.x), t.y);
	}
	return 0.0;
}

void main() {
	ivec2 id = ivec2(gl_GlobalInvocationID.xy);
	int n = params.misc.x;
	if (id.x >= n || id.y >= n) {
		return;
	}
	vec4 cell = imageLoad(field_src, id);
	float dt = params.flow.w;
	cell.g += weather.hydro.x * dt;
	vec2 position = (vec2(id) + 0.5 - float(n) * 0.5) * params.flow.z;
	for (int i = 0; i < int(springs.source[0].x); i++) {
		vec4 spring = springs.source[i + 1];
		vec2 d = (position - spring.xy) / max(spring.z, params.flow.z);
		cell.g += spring.w * dt * exp(-3.0 * dot(d, d));
	}
	cell.r += weather.hydro.z * dt * uplift_profile(id, n);

	if (springs.source[0].z > 0.5) {
		float melt = min(params.climate.x * dt, cell.b);
		cell.b -= melt;
		cell.g += melt;
	}

	float evap = min(params.climate.y * dt, cell.g);
	cell.g -= evap;
	cell.g -= min(springs.source[0].y * dt, cell.g);

	// Weather: snowfall adds depth above the snowline; freeze caps standing water
	// into a snow crust. Both are per-cell moves (freeze conserves, snowfall
	// is the sky's source term).
	if (springs.source[0].z > 0.5) {
		if (cell.r + cell.b > params.misc2.z) {
			cell.b += params.misc2.x * dt;
		}
		float frozen = min(params.misc2.y * dt, cell.g);
		cell.g -= frozen;
		cell.b += frozen;
	}

	// No water left to carry the load: it settles where it is.
	if (cell.g < RIVER_DRY_M && cell.a > 0.0) {
		cell.r += cell.a;
		cell.a = 0.0;
	}

	imageStore(field_src, id, cell);
}
