[resource]
script = ExtResource("3_preset")
display_name = "Sunset stacks"
hint = "Soot and steam rise from two stacks against a low sun. Fire a black puff from the soot stack."
layout = 1
environment = SubResource("Environment_sunset")
config = SubResource("Config_stacks")
