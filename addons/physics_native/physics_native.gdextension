[configuration]

entry_symbol = "physics_native_init"
compatibility_minimum = "4.7"

[libraries]

linux.debug.x86_64 = "res://addons/physics_native/bin/libphysics_native.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/physics_native/bin/libphysics_native.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://addons/physics_native/bin/libphysics_native.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/physics_native/bin/libphysics_native.windows.template_release.x86_64.dll"
android.debug.arm64 = "res://addons/physics_native/bin/libphysics_native.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/physics_native/bin/libphysics_native.android.template_release.arm64.so"
